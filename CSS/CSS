/* HyperAcess — estilos (CSS) */
/* ==========================================================================
   1. DESIGN SYSTEM & VARIÁVEIS CSS (WCAG AA/AAA + OKABE-ITO)
   ========================================================================== */
:root {
  --primary-color: #0A2540;
  --primary-light: #163E66;
  --secondary-color: #0077B6;
  --accent-color: #E69F00;
  --accent-hover: #C88700;
  --bg-body: #F4F7FA;
  --bg-surface: #FFFFFF;
  --bg-surface-alt: #EBF1F6;
  --text-primary: #102A43;
  --text-secondary: #334E68;
  --text-inverse: #FFFFFF;
  --border-color: #BCCCDC;
  --focus-outline: #D97706;

  /* Cores Semânticas para Ocorrências Urbanas (Paleta Segura) */
  --cor-buraco: #D55E00;
  --cor-rampa: #0072B2;
  --cor-piso: #009E73;
  --cor-semaforo: #CC79A7;
  --cor-obra: #E69F00;

  /* Tipografia e Espaçamento */
  --font-sans: 'Segoe UI', system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
  --font-size-base: 100%;
  --r-sm: 6px;
  --r-md: 12px;
  --r-lg: 18px;
  --shadow-sm: 0 2px 6px rgba(10, 37, 64, 0.08);
  --shadow-md: 0 8px 24px rgba(10, 37, 64, 0.12);
  --shadow-lg: 0 16px 36px rgba(10, 37, 64, 0.18);
  --transition: 0.25s ease;
}

/* ==========================================================================
   2. TEMAS DE ACESSIBILIDADE (ALTO CONTRASTE, ESCURO & DALTONISMO OKABE-ITO)
   ========================================================================== */
html.alto-contraste {
  --primary-color: #000000;
  --primary-light: #111111;
  --secondary-color: #FFFF00;
  --accent-color: #FFFF00;
  --accent-hover: #FFD700;
  --bg-body: #000000;
  --bg-surface: #0A0A0A;
  --bg-surface-alt: #1A1A1A;
  --text-primary: #FFFFFF;
  --text-secondary: #FFFF00;
  --text-inverse: #000000;
  --border-color: #FFFF00;
  --focus-outline: #00FFFF;
}

html.modo-escuro {
  --primary-color: #0F172A;
  --primary-light: #1E293B;
  --secondary-color: #38BDF8;
  --accent-color: #F59E0B;
  --accent-hover: #D97706;
  --bg-body: #0B1120;
  --bg-surface: #1E293B;
  --bg-surface-alt: #0F172A;
  --text-primary: #F8FAFC;
  --text-secondary: #CBD5E1;
  --text-inverse: #0F172A;
  --border-color: #334155;
  --focus-outline: #38BDF8;
}

/* Protanopia (vermelho): poucas mudanças, ocorrências em azul, marrom, mostarda e cinza */
html.protanopia {
  --accent-color: #F0B400;
  --accent-hover: #D19C00;
  --cor-buraco: #8F5A00;
  --cor-rampa: #004C99;
  --cor-piso: #2F6FC4;
  --cor-semaforo: #806B00;
  --cor-obra: #5A5A5A;
}

/* Deuteranopia (verde): parecida com a protanopia */
html.deuteranopia {
  --accent-color: #E6A800;
  --accent-hover: #C99300;
  --cor-buraco: #A35F00;
  --cor-rampa: #1A4D8F;
  --cor-piso: #3670B8;
  --cor-semaforo: #8A6E00;
  --cor-obra: #616161;
}

/* Tritanopia (azul/amarelo): maior mudança, azul vira grafite + ciano e laranja vira coral */
html.tritanopia {
  --primary-color: #1F2A30;
  --primary-light: #34444D;
  --secondary-color: #00737D;
  --accent-color: #FF8A80;
  --accent-hover: #F26B60;
  --cor-buraco: #D32F2F;
  --cor-rampa: #007A85;
  --cor-piso: #5D4037;
  --cor-semaforo: #880E4F;
  --cor-obra: #616161;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ==========================================================================
   3. RESET & BASE GLOBAL
   ========================================================================== */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: var(--font-size-base);
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-sans);
  background-color: var(--bg-body);
  color: var(--text-primary);
  line-height: 1.65;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

:focus-visible {
  outline: 4px solid var(--focus-outline);
  outline-offset: 2px;
}

.link-atalho {
  position: absolute;
  left: -9999px;
  top: 10px;
  background: var(--accent-color);
  color: #000000;
  font-weight: 700;
  padding: 12px 20px;
  border-radius: var(--r-sm);
  z-index: 9999;
  text-decoration: none;
}

.link-atalho:focus {
  left: 16px;
}

.container {
  width: 100%;
  max-width: 1220px;
  margin: 0 auto;
  padding: 0 20px;
}

/* ==========================================================================
   4. BARRA DE ACESSIBILIDADE & CABEÇALHO
   ========================================================================== */
.barra-acessibilidade {
  background-color: var(--primary-color);
  color: #FFFFFF;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  padding: 8px 0;
  font-size: 0.875rem;
}

.barra-acessibilidade .container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.acess-grupo {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.btn-acess {
  background: rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  border: 1px solid rgba(255, 255, 255, 0.35);
  padding: 6px 12px;
  border-radius: var(--r-sm);
  cursor: pointer;
  font-size: 0.85rem;
  font-weight: 600;
  min-height: 36px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: background var(--transition);
}

.btn-acess:hover, .btn-acess[aria-pressed="true"] {
  background: var(--accent-color);
  color: #000000;
  border-color: var(--accent-color);
}

header.cabecalho-principal {
  background-color: var(--bg-surface);
  border-bottom: 2px solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: var(--shadow-sm);
}

.header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  gap: 16px;
}

.logo-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  color: var(--text-primary);
}

.logo-icon {
  width: 44px;
  height: 44px;
  border-radius: var(--r-md);
  background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
  color: #FFFFFF;
  display: grid;
  place-items: center;
  font-weight: 800;
  font-size: 1.25rem;
  flex-shrink: 0;
}

.logo-text strong {
  display: block;
  font-size: 1.3rem;
  line-height: 1.1;
}

.logo-text span {
  font-size: 0.8rem;
  color: var(--text-secondary);
}

nav.nav-desktop ul {
  display: flex;
  flex-wrap: wrap;
  list-style: none;
  gap: 6px;
}

.nav-link {
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-primary);
  font-weight: 600;
  font-size: 0.92rem;
  padding: 8px 12px;
  border-radius: var(--r-sm);
  cursor: pointer;
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  transition: all var(--transition);
}

.nav-link:hover {
  background: var(--bg-surface-alt);
}

.nav-link.ativo, .nav-link[aria-current="page"] {
  background: var(--primary-color);
  color: #FFFFFF;
}

html.alto-contraste .nav-link.ativo {
  background: #FFFF00;
  color: #000000;
}

.btn-menu-mobile {
  display: none;
  background: var(--primary-color);
  color: #FFFFFF;
  border: none;
  border-radius: var(--r-sm);
  padding: 10px 14px;
  min-height: 44px;
  min-width: 44px;
  font-weight: 700;
  cursor: pointer;
}

/* Gaveta Mobile */
.drawer-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1999;
}

.drawer-backdrop.aberto {
  display: block;
}

.mobile-drawer {
  position: fixed;
  top: 0;
  right: -320px;
  width: 290px;
  max-width: 85vw;
  height: 100vh;
  background: var(--bg-surface);
  border-left: 2px solid var(--border-color);
  z-index: 2000;
  padding: 20px;
  overflow-y: auto;
  transition: right 0.3s ease;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mobile-drawer.aberto {
  right: 0;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border-color);
}

.mobile-drawer ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.mobile-drawer .nav-link {
  width: 100%;
  justify-content: flex-start;
}

@media (max-width: 1024px) {
  nav.nav-desktop {
    display: none;
  }
  .btn-menu-mobile {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
}

/* ==========================================================================
   5. SEÇÕES SPA (10 PÁGINAS) & COMPONENTES DE UI
   ========================================================================== */
main {
  flex: 1;
  padding: 28px 0 60px;
}

.spa-page {
  display: none;
  animation: fadeIn 0.25s ease;
}

.spa-page.ativa {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

.page-header {
  margin-bottom: 24px;
  padding-bottom: 16px;
  border-bottom: 2px solid var(--border-color);
}

.badge-tag {
  display: inline-block;
  background: var(--bg-surface-alt);
  color: var(--secondary-color);
  border: 1px solid var(--border-color);
  font-weight: 700;
  font-size: 0.8rem;
  padding: 4px 10px;
  border-radius: 999px;
  margin-bottom: 8px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

h1 {
  font-size: clamp(1.75rem, 3vw, 2.4rem);
  line-height: 1.2;
  margin-bottom: 8px;
}

h2 {
  font-size: clamp(1.35rem, 2.2vw, 1.8rem);
  margin-bottom: 12px;
}

h3 {
  font-size: 1.15rem;
  margin-bottom: 8px;
}

.hero-banner {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
  color: #FFFFFF;
  border-radius: var(--r-lg);
  padding: clamp(24px, 4vw, 44px);
  margin-bottom: 28px;
  box-shadow: var(--shadow-md);
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 24px;
  align-items: center;
}

@media (max-width: 820px) {
  .hero-banner {
    grid-template-columns: 1fr;
  }
}

.hero-banner p {
  font-size: 1.08rem;
  opacity: 0.95;
  margin-bottom: 20px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.btn-primary {
  background: var(--accent-color);
  color: #000000;
  border: 2px solid var(--accent-color);
  padding: 12px 20px;
  border-radius: var(--r-sm);
  font-weight: 700;
  font-size: 0.95rem;
  cursor: pointer;
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-decoration: none;
  transition: all var(--transition);
}

.btn-primary:hover {
  background: var(--accent-hover);
  border-color: var(--accent-hover);
}

.btn-secondary {
  background: var(--bg-surface);
  color: var(--text-primary);
  border: 2px solid var(--border-color);
  padding: 12px 20px;
  border-radius: var(--r-sm);
  font-weight: 700;
  font-size: 0.95rem;
  cursor: pointer;
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all var(--transition);
}

.btn-secondary:hover {
  background: var(--bg-surface-alt);
}

.grid-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
  margin-bottom: 28px;
}

.card {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--r-md);
  padding: 22px;
  box-shadow: var(--shadow-sm);
}

.stat-number {
  font-size: 2.1rem;
  font-weight: 800;
  color: var(--secondary-color);
  line-height: 1.1;
  margin-bottom: 6px;
}

/* ==========================================================================
   6. MAPA INTERATIVO TIPO GOOGLE EARTH (SATÉLITE + RUAS + 3D/HÍBRIDO)
   ========================================================================== */
.mapa-controles {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 16px;
  background: var(--bg-surface);
  padding: 16px;
  border-radius: var(--r-md);
  border: 1px solid var(--border-color);
  align-items: center;
}

.mapa-controles select, .mapa-controles input {
  max-width: 100%;
  padding: 10px 14px;
  border-radius: var(--r-sm);
  border: 1px solid var(--border-color);
  background: var(--bg-body);
  color: var(--text-primary);
  min-height: 44px;
  font-size: 0.95rem;
}

.mapa-wrapper {
  position: relative;
  width: 100%;
  border-radius: var(--r-md);
  overflow: hidden;
  border: 2px solid var(--border-color);
  margin-bottom: 16px;
  box-shadow: var(--shadow-md);
}

#mapa-leaflet {
  width: 100%;
  height: 500px;
  z-index: 1;
  background: #0b192c;
}

.mapa-camadas-barra {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 10px 14px;
  background: #0A2540;
  color: #FFFFFF;
  align-items: center;
  justify-content: space-between;
}

.btn-camada {
  background: rgba(255,255,255,0.14);
  color: #FFFFFF;
  border: 1px solid rgba(255,255,255,0.3);
  padding: 6px 12px;
  border-radius: var(--r-sm);
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
  min-height: 36px;
}

.btn-camada.ativa {
  background: var(--accent-color);
  color: #000000;
  border-color: var(--accent-color);
}

.legenda-mapa {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  padding: 12px 16px;
  background: var(--bg-surface);
  border-radius: var(--r-md);
  border: 1px solid var(--border-color);
  font-size: 0.9rem;
}

.legenda-item {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
}

.sinalizadores {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.btn-sinalizador {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--bg-body);
  color: var(--text-primary);
  border: 2px solid var(--border-color);
  border-radius: 999px;
  padding: 6px 14px 6px 6px;
  min-height: 44px;
  font-weight: 700;
  cursor: pointer;
}

.btn-sinalizador.ativo {
  border-color: var(--accent-color);
  box-shadow: 0 0 0 2px var(--accent-color);
}

.marcar-linha {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.marcar-linha input {
  flex: 1 1 220px;
  min-width: 0;
  padding: 10px 14px;
  border-radius: var(--r-sm);
  border: 1px solid var(--border-color);
  background: var(--bg-body);
  color: var(--text-primary);
  min-height: 44px;
}

#mapa-leaflet.modo-marcar {
  cursor: crosshair;
  outline: 4px dashed var(--accent-color);
  outline-offset: -4px;
}

.lista-chamados-regiao {
  list-style: none;
  display: grid;
  gap: 8px;
}

.lista-chamados-regiao li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 12px;
  border: 1px solid var(--border-color);
  border-radius: var(--r-sm);
  background: var(--bg-body);
}

.pino-badge {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  color: #FFFFFF;
  font-weight: 800;
  font-size: 0.78rem;
  display: inline-grid;
  place-items: center;
}

/* ==========================================================================
   7. FORMULÁRIOS ACESSÍVEIS & TABELAS RESPONSIVAS
   ========================================================================== */
.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 14px;
}

.form-group label {
  font-weight: 700;
  font-size: 0.95rem;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 12px 14px;
  border: 2px solid var(--border-color);
  border-radius: var(--r-sm);
  background: var(--bg-surface);
  color: var(--text-primary);
  font-family: inherit;
  font-size: 1rem;
  min-height: 48px;
}

.dica-campo {
  color: var(--text-secondary);
  font-size: 0.85rem;
}

.remetente-box {
  padding: 12px 14px;
  border: 2px dashed var(--border-color);
  border-radius: var(--r-sm);
  background: var(--bg-surface-alt);
  font-weight: 700;
  overflow-wrap: anywhere;
}

.link-inline {
  background: none;
  border: none;
  padding: 0;
  color: var(--secondary-color);
  font: inherit;
  font-weight: 700;
  text-decoration: underline;
  cursor: pointer;
}

.ditado-linha {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin-top: 4px;
}

#btn-ditado[aria-pressed="true"] {
  background: #B91C1C;
  border-color: #B91C1C;
  color: #FFFFFF;
}

.ong-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
  margin-top: 14px;
}

.dados-pix {
  display: grid;
  gap: 4px;
  padding: 12px 14px;
  margin: 10px 0;
  border-radius: var(--r-sm);
  background: var(--bg-surface-alt);
  border: 1px solid var(--border-color);
  overflow-wrap: anywhere;
}

.erro-campo {
  color: #B91C1C;
  font-size: 0.85rem;
  font-weight: 700;
  min-height: 20px;
}

html.alto-contraste .erro-campo,
html.modo-escuro .erro-campo {
  color: #FCA5A5;
}

.tabela-resp {
  width: 100%;
  overflow-x: auto;
  background: var(--bg-surface);
  border-radius: var(--r-md);
  border: 1px solid var(--border-color);
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 600px;
}

th, td {
  padding: 14px 16px;
  text-align: left;
  border-bottom: 1px solid var(--border-color);
}

th {
  background: var(--bg-surface-alt);
  font-weight: 700;
}

/* ==========================================================================
   8. GRÁFICOS CSS & BARRAS DE PROGRESSO (PREFEITURAS / HOME)
   ========================================================================== */
.barra-grafico-wrap {
  margin-bottom: 14px;
}

.barra-grafico-label {
  display: flex;
  justify-content: space-between;
  font-weight: 700;
  margin-bottom: 4px;
  font-size: 0.92rem;
}

.barra-grafico-track {
  width: 100%;
  height: 16px;
  background: var(--bg-surface-alt);
  border-radius: 999px;
  overflow: hidden;
  border: 1px solid var(--border-color);
}

.barra-grafico-fill {
  height: 100%;
  background: var(--secondary-color);
  border-radius: 999px;
  transition: width 0.5s ease;
}

/* ==========================================================================
   9. FAQ (DETAILS/SUMMARY) & VÍDEO DEMONSTRATIVO INTERATIVO (PAG 9)
   ========================================================================== */
details.faq-item {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--r-md);
  padding: 16px 20px;
  margin-bottom: 12px;
}

details.faq-item summary {
  font-weight: 700;
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 36px;
}

details.faq-item p {
  margin-top: 12px;
  color: var(--text-secondary);
}

.video-box {
  background: var(--bg-surface);
  border: 2px solid var(--border-color);
  border-radius: var(--r-lg);
  padding: 20px;
  margin-bottom: 24px;
}

.iframe-video {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  border: 0;
}

.fonte-link {
  margin-top: 12px;
  text-decoration: none;
}

.player-wrapper {
  position: relative;
  width: 100%;
  border-radius: var(--r-md);
  overflow: hidden;
  background: #071324;
  border: 1px solid var(--border-color);
}

#canvas-video-demo {
  width: 100%;
  height: 380px;
  display: block;
  background: linear-gradient(135deg, #071324 0%, #0A2540 60%, #004E7C 100%);
}

.legenda-video-overlay {
  position: absolute;
  bottom: 52px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.85);
  color: #FFFF00;
  padding: 8px 16px;
  border-radius: var(--r-sm);
  font-weight: 700;
  font-size: 0.95rem;
  max-width: 90%;
  text-align: center;
  border: 1px solid rgba(255, 255, 255, 0.25);
}

.barra-progresso-video {
  width: 100%;
  height: 8px;
  background: rgba(255, 255, 255, 0.2);
  cursor: pointer;
}

.barra-progresso-video-fill {
  height: 100%;
  width: 0%;
  background: var(--accent-color);
  transition: width 0.2s linear;
}

.video-controles-extra {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 14px;
  align-items: center;
}

/* ==========================================================================
   10. WIDGET ASSISTENTE VIRTUAL (CHATBOT IA SEM DEPENDÊNCIA EXTERNA)
   ========================================================================== */
.chat-launcher {
  position: fixed;
  bottom: 22px;
  right: 22px;
  background: var(--primary-color);
  color: #FFFFFF;
  border: 2px solid var(--accent-color);
  border-radius: 999px;
  padding: 14px 20px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: var(--shadow-lg);
  z-index: 1500;
  min-height: 52px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.chat-janela {
  position: fixed;
  bottom: 86px;
  right: 22px;
  width: 380px;
  max-width: calc(100vw - 32px);
  background: var(--bg-surface);
  border: 2px solid var(--border-color);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-lg);
  z-index: 1501;
  display: none;
  flex-direction: column;
  overflow: hidden;
}

.chat-janela.aberto {
  display: flex;
}

.chat-topo {
  background: var(--primary-color);
  color: #FFFFFF;
  padding: 12px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.chat-topo-acoes {
  display: flex;
  align-items: center;
  gap: 6px;
}

.btn-chat-voz {
  background: var(--accent-color);
  color: #000000;
  border: none;
  border-radius: var(--r-sm);
  padding: 5px 10px;
  font-size: 0.78rem;
  font-weight: 800;
  cursor: pointer;
  min-height: 32px;
}

.chat-mensagens {
  padding: 16px;
  height: 290px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: var(--bg-body);
}

.msg-bot, .msg-user {
  padding: 10px 14px;
  border-radius: var(--r-md);
  max-width: 86%;
  font-size: 0.92rem;
  line-height: 1.45;
}

.msg-bot {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  align-self: flex-start;
}

.msg-user {
  background: var(--primary-color);
  color: #FFFFFF;
  align-self: flex-end;
}

.chat-sugestoes {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 8px 12px;
  background: var(--bg-surface);
  border-top: 1px solid var(--border-color);
}

.chip-sugestao {
  font-size: 0.78rem;
  padding: 5px 10px;
  border-radius: 999px;
  border: 1px solid var(--border-color);
  background: var(--bg-surface-alt);
  color: var(--text-primary);
  cursor: pointer;
  font-weight: 600;
}

.chat-form {
  display: flex;
  border-top: 1px solid var(--border-color);
  background: var(--bg-surface);
}

.chat-form input {
  flex: 1;
  border: none;
  padding: 12px 14px;
  background: transparent;
  color: var(--text-primary);
  font-size: 0.95rem;
}

.chat-form button {
  background: var(--accent-color);
  color: #000000;
  border: none;
  padding: 0 18px;
  font-weight: 700;
  cursor: pointer;
}

/* ==========================================================================
   11. RODAPÉ
   ========================================================================== */
footer.rodape {
  background: var(--primary-color);
  color: #FFFFFF;
  padding: 36px 0 24px;
  margin-top: auto;
  border-top: 3px solid var(--accent-color);
}

.rodape-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 24px;
  margin-bottom: 24px;
}

.rodape h3 {
  color: var(--accent-color);
  margin-bottom: 10px;
}

.rodape ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.rodape a, .rodape button.link-rodape {
  color: #E2E8F0;
  text-decoration: none;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 0.92rem;
  text-align: left;
  padding: 2px 0;
}

.rodape a:hover, .rodape button.link-rodape:hover {
  text-decoration: underline;
  color: #FFFFFF;
}

.rodape-copy {
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  padding-top: 16px;
  font-size: 0.85rem;
  text-align: center;
  color: #CBD5E1;
}

@media (max-width: 480px) {
  .form-grid {
    grid-template-columns: 1fr;
  }
  .chat-janela {
    right: 10px;
    bottom: 80px;
    width: calc(100vw - 20px);
  }
  #canvas-video-demo {
    height: 270px;
  }
}

