const htmlEl = document.documentElement;
let tamanhoFonte = Number(localStorage.getItem('ha_fonte')) || 100;

function aplicarFonte() {
  htmlEl.style.setProperty('--font-size-base', tamanhoFonte + '%');
  localStorage.setItem('ha_fonte', tamanhoFonte);
}
aplicarFonte();

document.getElementById('btn-fonte-mais').addEventListener('click', () => {
  if (tamanhoFonte < 135) { tamanhoFonte += 10; aplicarFonte(); }
});
document.getElementById('btn-fonte-menos').addEventListener('click', () => {
  if (tamanhoFonte > 80) { tamanhoFonte -= 10; aplicarFonte(); }
});
document.getElementById('btn-fonte-reset').addEventListener('click', () => {
  tamanhoFonte = 100; aplicarFonte();
});

function configurarTemaToggle(btnId, classeCss, storageKey) {
  const btn = document.getElementById(btnId);
  if (localStorage.getItem(storageKey) === 'true') {
    htmlEl.classList.add(classeCss);
    btn.setAttribute('aria-pressed', 'true');
  }
  btn.addEventListener('click', () => {
    const ativo = htmlEl.classList.toggle(classeCss);
    btn.setAttribute('aria-pressed', String(ativo));
    localStorage.setItem(storageKey, String(ativo));
  });
}

configurarTemaToggle('btn-contraste', 'alto-contraste', 'ha_contraste');
configurarTemaToggle('btn-escuro', 'modo-escuro', 'ha_escuro');

