let camadaMarcadores = null;
let layerSatelite = null;
let layerRotulos = null;
let layerMapaRuas = null;

function iniciarMapaLeaflet() {
  atualizarListaRegiao();
  if (typeof L === 'undefined') return;
  if (!mapaInstancia) {
    mapaInstancia = L.map('mapa-leaflet', {
      center: [-23.5614, -46.6559],
      zoom: 15,
      maxZoom: 19
    });

    // Camada Satélite de Alta Resolução (Estilo Google Earth)
    layerSatelite = L.tileLayer(
      'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
      {
        attribution: 'Imagens de Satélite &copy; Esri, Maxar, Earthstar Geographics',
        maxZoom: 19
      }
    );

    // Camada de Rótulos de Ruas, Bairros e Referências sobre o Satélite (Modo Híbrido)
    layerRotulos = L.tileLayer(
      'https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}',
      {
        maxZoom: 19
      }
    );

    // Camada Mapa Urbano Tradicional (Opcional)
    layerMapaRuas = L.tileLayer(
      'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
      {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 19
      }
    );

    // Inicia no modo Satélite Híbrido (Google Earth)
    layerSatelite.addTo(mapaInstancia);
    layerRotulos.addTo(mapaInstancia);

    camadaMarcadores = L.layerGroup().addTo(mapaInstancia);

    // Clique no mapa com o modo de marcação ligado cria a ocorrência naquele ponto
    mapaInstancia.on('click', (e) => {
      if (modoMarcar) adicionarMarcacao(e.latlng.lat, e.latlng.lng);
    });
  }
  renderizarMarcadores();
}

