});

/* Ditado por voz na mensagem (microfone do computador ou do celular) */
const Reconhecimento = window.SpeechRecognition || window.webkitSpeechRecognition;
const btnDitado = document.getElementById('btn-ditado');
const statusDitado = document.getElementById('status-ditado');
const campoMensagem = document.getElementById('contato-mensagem');
let reconhecedor = null;
let ditadoAtivo = false;

function pararDitado() {
  if (!ditadoAtivo) return;
  ditadoAtivo = false;
  if (reconhecedor) { try { reconhecedor.stop(); } catch (err) {} }
  btnDitado.setAttribute('aria-pressed', 'false');
  btnDitado.textContent = '🎤 Falar a mensagem';
  statusDitado.textContent = 'Ditado encerrado. Revise o texto antes de enviar.';
}

function iniciarDitado() {
  if (!Reconhecimento) {
    statusDitado.textContent = 'Este navegador não faz ditado por voz. No celular, use o 🎤 do teclado; no computador, use Chrome ou Edge.';
    return;
  }
  if ('speechSynthesis' in window) window.speechSynthesis.cancel();   // a narração não atrapalha o microfone
  reconhecedor = new Reconhecimento();
  reconhecedor.lang = 'pt-BR';
  reconhecedor.interimResults = true;
  reconhecedor.continuous = false;            // reinicia sozinho: funciona melhor no celular
  reconhecedor.onresult = (ev) => {
    let final = '', parcial = '';
    for (let i = ev.resultIndex; i < ev.results.length; i++) {
      if (ev.results[i].isFinal) final += ev.results[i][0].transcript;
      else parcial += ev.results[i][0].transcript;
    }
    if (final.trim()) {
      const atual = campoMensagem.value.trim();
      campoMensagem.value = (atual ? atual + ' ' : '') + final.trim();
      document.getElementById('erro-contato-msg').textContent = '';
    }
    statusDitado.textContent = parcial ? '🎙️ Ouvindo: ' + parcial : '🎙️ Ouvindo... fale sua mensagem. Toque de novo para parar.';
  };
  reconhecedor.onerror = (ev) => {
    if (ev.error === 'no-speech') return;
    const msgs = {
      'not-allowed': 'Permissão do microfone negada. Libere o microfone no cadeado da barra de endereço.',
      'service-not-allowed': 'Permissão do microfone negada. Libere o microfone no cadeado da barra de endereço.',
      'audio-capture': 'Nenhum microfone encontrado neste aparelho.',
      'network': 'O ditado precisa de internet. Verifique a conexão.'
    };
    ditadoAtivo = true; pararDitado();
    statusDitado.textContent = msgs[ev.error] || 'Não foi possível usar o microfone agora. Tente novamente.';
  };
  reconhecedor.onend = () => {
    if (ditadoAtivo) { try { reconhecedor.start(); } catch (err) {} }
  };
  try {
    reconhecedor.start();
    ditadoAtivo = true;
    btnDitado.setAttribute('aria-pressed', 'true');
    btnDitado.textContent = '⏹️ Parar de falar';
    statusDitado.textContent = '🎙️ Ouvindo... fale sua mensagem. Toque de novo para parar.';
  } catch (err) {
    statusDitado.textContent = 'Não foi possível iniciar o microfone. Tente novamente.';
  }
}

btnDitado.addEventListener('click', () => (ditadoAtivo ? pararDitado() : iniciarDitado()));
