const nomesDaltonismo = ['Desligado', 'Protanopia', 'Deuteranopia', 'Tritanopia'];
const btnDaltonismo = document.getElementById('btn-daltonismo');
let idxDaltonismo = Math.max(0, tiposDaltonismo.indexOf(localStorage.getItem('ha_daltonismo') || ''));

function aplicarDaltonismo() {
  tiposDaltonismo.forEach(t => { if (t) htmlEl.classList.toggle(t, t === tiposDaltonismo[idxDaltonismo]); });
  btnDaltonismo.textContent = 'Daltonismo: ' + nomesDaltonismo[idxDaltonismo];
  btnDaltonismo.setAttribute('aria-pressed', String(idxDaltonismo > 0));
  localStorage.setItem('ha_daltonismo', tiposDaltonismo[idxDaltonismo]);
  if (mapaInstancia) renderizarMarcadores();
