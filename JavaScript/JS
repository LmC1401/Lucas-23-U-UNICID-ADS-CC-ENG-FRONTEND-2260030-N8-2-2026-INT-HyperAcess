/* ==========================================================================
   5B. COMPARADOR DE ROTAS (PÁGINA 5) — 3 trajetos com danos fictícios
   ========================================================================== */
// Mesmo trajeto e perfil geram sempre o mesmo resultado; trocar a partida,
// o destino ou o perfil gera um novo comparativo. Os danos são fictícios (demonstração).
function sementeTexto(texto) {
  let h = 2166136261;
  for (let i = 0; i < texto.length; i++) { h ^= texto.charCodeAt(i); h = Math.imul(h, 16777619); }
  return h >>> 0;
}
function geradorAleatorio(semente) {          // números "aleatórios" repetíveis
  let a = semente || 1;
  return () => { a = (a + 0x6D2B79F5) >>> 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t ^= t + Math.imul(t ^ (t >>> 7), 61 | t); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
}
function escaparHTML(t) {
  return String(t).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

// Tipos de dano e quanto cada um pesa para cada perfil
const danosRota = [
  { id: 'buraco', nome: ['buraco na calçada', 'buracos na calçada'], peso: { cadeirante: 14, visual: 10, idoso: 13 } },
  { id: 'rampa', nome: ['esquina sem rampa', 'esquinas sem rampa'], peso: { cadeirante: 18, visual: 5, idoso: 10 } },
  { id: 'piso', nome: ['trecho de piso tátil interrompido', 'trechos de piso tátil interrompidos'], peso: { cadeirante: 3, visual: 18, idoso: 4 } },
  { id: 'semaforo', nome: ['semáforo sem alerta sonoro', 'semáforos sem alerta sonoro'], peso: { cadeirante: 4, visual: 16, idoso: 8 } },
  { id: 'obra', nome: ['obra bloqueando a passagem', 'obras bloqueando a passagem'], peso: { cadeirante: 16, visual: 12, idoso: 12 } },
  { id: 'estreita', nome: ['calçada estreita com postes', 'calçadas estreitas com postes'], peso: { cadeirante: 12, visual: 8, idoso: 7 } },
  { id: 'desnivel', nome: ['degrau ou desnível', 'degraus ou desníveis'], peso: { cadeirante: 15, visual: 9, idoso: 14 } }
];
const nomesPerfilRota = { cadeirante: 'cadeirante / mobilidade reduzida', visual: 'pessoa com deficiência visual', idoso: 'idoso / carrinho de bebê' };
const velocidadePerfil = { cadeirante: 60, visual: 55, idoso: 50 };   // metros por minuto

function calcularRotas() {
  const origem = document.getElementById('rota-origem').value.trim();
  const destino = document.getElementById('rota-destino').value.trim();
  const perfil = document.getElementById('rota-perfil').value;
  const status = document.getElementById('status-rotas');
  if (!origem || !destino) { status.textContent = 'Informe o ponto de partida e o destino.'; return; }
  if (origem.toLowerCase() === destino.toLowerCase()) { status.textContent = 'O ponto de partida e o destino precisam ser diferentes.'; return; }

  const sorte = geradorAleatorio(sementeTexto(origem.toLowerCase() + '|' + destino.toLowerCase() + '|' + perfil));
  const distanciaBase = Math.round((400 + sorte() * 2000) / 10) * 10;   // de 400 m a 2,4 km
  const modelos = [
    { nome: 'Trajeto A — Via Corredor Tátil', fator: 1.18 + sorte() * 0.12, maxDanos: 2 },
    { nome: 'Trajeto B — Via Avenida Principal', fator: 1.06 + sorte() * 0.08, maxDanos: 3 },
    { nome: 'Trajeto C — Caminho Mais Curto', fator: 1.0, maxDanos: 4 }
  ];

  const rotas = modelos.map(m => {
    const distancia = Math.round(distanciaBase * m.fator / 10) * 10;
    const qtdTipos = Math.floor(sorte() * (m.maxDanos + 1));      // 0 até maxDanos tipos de dano
    const tipos = danosRota.slice().sort(() => sorte() - 0.5).slice(0, qtdTipos);
    let penalidade = 0, atraso = 0;
    const danos = tipos.map(t => {
      const qtd = 1 + Math.floor(sorte() * 2);
      penalidade += t.peso[perfil] * qtd;
      atraso += qtd;
      return qtd + ' ' + (qtd > 1 ? t.nome[1] : t.nome[0]);
    });
    const acessivel = Math.max(15, Math.min(99, Math.round(99 - penalidade - distancia / 400)));
    const minutos = Math.round(distancia / velocidadePerfil[perfil] + atraso);
    return { nome: m.nome, distancia, minutos, danos, acessivel };
  });

  // Comparativo: maior acessibilidade primeiro; empate = menor tempo
  rotas.sort((a, b) => b.acessivel - a.acessivel || a.minutos - b.minutos);
  const rotulos = [
    { texto: '⭐ Rota Recomendada', estilo: 'background:var(--cor-piso); color:#FFF;', borda: 'border:2px solid var(--cor-piso);', item: 'Infraestrutura' },
    { texto: 'Rota Moderada', estilo: '', borda: '', item: 'Atenção' },
    { texto: '⚠ Pior Rota', estilo: 'background:var(--cor-buraco); color:#FFF;', borda: '', item: 'Alerta Crítico' }
  ];
  const km = m => m >= 1000 ? (m / 1000).toFixed(2).replace('.', ',') + ' km' : m + ' m';

  document.getElementById('resultado-rotas').innerHTML = rotas.map((r, i) => `
    <article class="card"${rotulos[i].borda ? ` style="${rotulos[i].borda}"` : ''}>
      <span class="badge-tag"${rotulos[i].estilo ? ` style="${rotulos[i].estilo}"` : ''}>${rotulos[i].texto} (${r.acessivel}% Acessível)</span>
      <h3>${r.nome}</h3>
      <p><strong>Tempo estimado:</strong> ${r.minutos} min (${km(r.distancia)})</p>
      <p><strong>${r.danos.length ? rotulos[i].item : 'Infraestrutura'}:</strong> ${r.danos.length ? r.danos.join(', ') + ' (danos fictícios).' : 'sem barreiras reportadas neste trajeto.'}</p>
    </article>`).join('');

  const resumo = `Comparativo de ${origem} até ${destino} para ${nomesPerfilRota[perfil]}: ` +
    `recomendada ${rotas[0].nome.split(' — ')[0]} (${rotas[0].acessivel}%), moderada ${rotas[1].nome.split(' — ')[0]} (${rotas[1].acessivel}%) ` +
    `e pior ${rotas[2].nome.split(' — ')[0]} (${rotas[2].acessivel}%).`;
  status.textContent = '✅ ' + resumo + ' Dados fictícios para demonstração.';
  if (typeof iaVozAtiva !== 'undefined' && iaVozAtiva) falarRespostaIA(resumo);   // só fala com a narração ligada
}

document.getElementById('btn-calcular-rotas').addEventListener('click', calcularRotas);
