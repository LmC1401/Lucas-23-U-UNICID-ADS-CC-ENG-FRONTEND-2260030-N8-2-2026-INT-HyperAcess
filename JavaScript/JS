// Telefone do estado de SP: DDD 11 a 19; celular com 9 dígitos começando em 9, fixo com 8 dígitos começando em 2 a 5
function formatarTelefone(valor) {
  const d = valor.replace(/\D/g, '').slice(0, 11);
  if (d.length <= 2) return d.length ? '(' + d : '';
  if (d.length <= 6) return `(${d.slice(0, 2)}) ${d.slice(2)}`;
  if (d.length <= 10) return `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`;
  return `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;
}
function telefoneSPValido(valor) {
  const d = valor.replace(/\D/g, '');
  const ddd = Number(d.slice(0, 2));
  if (ddd < 11 || ddd > 19) return false;
  const numero = d.slice(2);
  if (/^(\d)\1+$/.test(numero)) return false;                 // ex.: 99999-9999
  if (d.length === 11) return numero[0] === '9';                // celular
  if (d.length === 10) return /^[2-5]/.test(numero);            // fixo
  return false;
}
// E-mail válido de provedores conhecidos (ou institucional .edu.br / .gov.br)
const provedoresEmail = ['gmail.com', 'outlook.com', 'outlook.com.br', 'hotmail.com', 'hotmail.com.br', 'live.com', 'msn.com',
  'yahoo.com', 'yahoo.com.br', 'icloud.com', 'me.com', 'uol.com.br', 'bol.com.br', 'terra.com.br', 'ig.com.br', 'globo.com',
  'globomail.com', 'protonmail.com', 'proton.me', 'zoho.com', 'aol.com'];
function emailValidoProvedor(valor) {
  const email = valor.trim().toLowerCase();
  if (!/^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$/.test(email) || email.includes('..')) return false;
  const dominio = email.split('@')[1];
  return provedoresEmail.includes(dominio) || /\.(edu|gov)\.br$/.test(dominio);
}

