   1. NAVEGAÇÃO SPA (10 PÁGINAS) & GAVETA MOBILE
   ========================================================================== */
const paginas = document.querySelectorAll('.spa-page');
const botoesNav = document.querySelectorAll('[data-nav]');
const drawer = document.getElementById('drawer-mobile');
const backdrop = document.getElementById('drawer-backdrop');
const btnAbrirDrawer = document.getElementById('btn-abrir-drawer');
const btnFecharDrawer = document.getElementById('btn-fechar-drawer');
let mapaInstancia = null;

function navegarPara(idPagina) {
  paginas.forEach(sec => sec.classList.remove('ativa'));
  const alvo = document.getElementById(idPagina);
  if (alvo) alvo.classList.add('ativa');

  botoesNav.forEach(btn => {
    const ativo = btn.getAttribute('data-nav') === idPagina;
    btn.classList.toggle('ativo', ativo);
    if (ativo) {
      btn.setAttribute('aria-current', 'page');
    } else {
      btn.removeAttribute('aria-current');
    }
  });

  fecharDrawer();
  window.scrollTo({ top: 0, behavior: 'smooth' });

  if (idPagina === 'pag-3') {
    setTimeout(() => {
      iniciarMapaLeaflet();
      if (mapaInstancia) mapaInstancia.invalidateSize();
    }, 120);
  }

  if (idPagina === 'pag-9') {
    desenharFrameVideo(0);
  }
}

botoesNav.forEach(btn => {
  btn.addEventListener('click', (e) => {
    e.preventDefault();
    navegarPara(btn.getAttribute('data-nav'));
  });
});

function abrirDrawer() {
  drawer.classList.add('aberto');
  backdrop.classList.add('aberto');
  drawer.setAttribute('aria-hidden', 'false');
  btnAbrirDrawer.setAttribute('aria-expanded', 'true');
}

function fecharDrawer() {
  drawer.classList.remove('aberto');
  backdrop.classList.remove('aberto');
  drawer.setAttribute('aria-hidden', 'true');
  btnAbrirDrawer.setAttribute('aria-expanded', 'false');
}

btnAbrirDrawer.addEventListener('click', abrirDrawer);
btnFecharDrawer.addEventListener('click', fecharDrawer);
backdrop.addEventListener('click', fecharDrawer);
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    fecharDrawer();
    fecharChat();
  }
});

