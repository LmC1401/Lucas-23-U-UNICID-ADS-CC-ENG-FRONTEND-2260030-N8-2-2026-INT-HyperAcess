function regiaoMaisProxima(lat, lng) {
  let melhor = 'Centro SP', menor = Infinity;
  Object.keys(centrosRegioes).forEach(r => {
    if (r === 'todas') return;
    const d = Math.pow(centrosRegioes[r].c[0] - lat, 2) + Math.pow(centrosRegioes[r].c[1] - lng, 2);
    if (d < menor) { menor = d; melhor = r; }
  });
  return melhor;
}

function atualizarListaRegiao() {
  const reg = document.getElementById('filtro-regiao').value;
  const nomeRegiao = reg === 'todas' ? 'Todas as regiões' : reg;
  document.getElementById('titulo-chamados-regiao').textContent = '📋 Chamados abertos — ' + nomeRegiao;
  const doMapa = ocorrenciasIniciais.concat(marcacoesUsuario)
    .filter(o => o.status !== 'Resolvido' && (reg === 'todas' || o.regiao === reg))
    .map(o => ({ letra: configPinos[o.cat].letra, cat: o.cat, texto: o.titulo, info: o.regiao + ' · ' + o.status }));
  const daCentral = chamadosSalvos
    .filter(c => c.status !== 'Resolvido' && (reg === 'todas' || String(c.regiao).indexOf(reg) === 0))
    .map(c => ({ letra: '#', cat: '', texto: c.protocolo + ' — ' + c.categoria, info: c.regiao + ' · ' + c.status }));
  const itens = doMapa.concat(daCentral);
  const lista = document.getElementById('lista-chamados-regiao');
  lista.innerHTML = itens.length ? '' : '<li>Nenhum chamado aberto nesta região.</li>';
  itens.forEach(i => {
    const li = document.createElement('li');
    const badge = document.createElement('span');
    badge.className = 'pino-badge';
    badge.style.background = i.cat ? 'var(--cor-' + i.cat + ')' : 'var(--text-secondary)';
    badge.textContent = i.letra;
    const txt = document.createElement('span');
    txt.innerHTML = '<strong></strong><br><small></small>';
    txt.querySelector('strong').textContent = i.texto;   // textContent: evita inserir HTML digitado
    txt.querySelector('small').textContent = i.info;
    li.appendChild(badge); li.appendChild(txt);
    lista.appendChild(li);
  });
}

function adicionarMarcacao(lat, lng) {
  const desc = document.getElementById('marcar-descricao').value.trim();
  const nova = {
    id: Date.now(), cat: tipoMarcacao, regiao: regiaoMaisProxima(lat, lng),
    titulo: nomesTipos[tipoMarcacao] + (desc ? ' — ' + desc : ' (marcado por você)'),
    lat: lat, lng: lng, status: 'Aberto'
  };
  marcacoesUsuario.push(nova);
  localStorage.setItem('ha_marcacoes', JSON.stringify(marcacoesUsuario));
  document.getElementById('marcar-descricao').value = '';
  ligarModoMarcar(false);
  renderizarMarcadores();
  document.getElementById('status-marcacao').textContent = `✅ ${nomesTipos[nova.cat]} marcado em ${nova.regiao} (${lat.toFixed(4)}, ${lng.toFixed(4)}).`;
}

function ligarModoMarcar(ligar) {
  modoMarcar = ligar;
