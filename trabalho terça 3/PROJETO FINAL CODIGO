html.alto-contraste .logo { color: #ffff00; }
html.alto-contraste .btn, html.alto-contraste .btn-cta, html.alto-contraste .btn-submit {
  background: #000; color: #ffff00; border: 3px solid #ffff00;
}
html.alto-contraste .btn-menu, html.alto-contraste .btn-fechar { background: #ffff00; color: #000; }
