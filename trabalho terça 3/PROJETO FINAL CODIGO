  <script>
    /* ==========================================================================
       1. NAVEGAÇÃO SPA (10 PÁGINAS) & GAVETA MOBILE
       ========================================================================== */
    const paginas = document.querySelectorAll('.spa-page');
    const botoesNav = document.querySelectorAll('[data-nav]');
    const drawer = document.getElementById('drawer-mobile');
    const backdrop = document.getElementById('drawer-backdrop');
    const btnAbrirDrawer = document.getElementById('btn-abrir-drawer');
    const btnFecharDrawer = document.getElementById('btn-fechar-drawer');
    let mapaInstancia = null;

    function navegarPara(idPagina) {
      paginas.forEach(sec => sec.classList.remove('ativa'));
      const alvo = document.getElementById(idPagina);
      if (alvo) alvo.classList.add('ativa');

      botoesNav.forEach(btn => {
        const ativo = btn.getAttribute('data-nav') === idPagina;
        btn.classList.toggle('ativo', ativo);
        if (ativo) {
          btn.setAttribute('aria-current', 'page');
        } else {
          btn.removeAttribute('aria-current');
        }
      });

      fecharDrawer();
      window.scrollTo({ top: 0, behavior: 'smooth' });

      if (idPagina === 'pag-3') {
        setTimeout(() => {
          iniciarMapaLeaflet();
          if (mapaInstancia) mapaInstancia.invalidateSize();
        }, 120);
      }

      if (idPagina === 'pag-9') {
        desenharFrameVideo(0);
      }
    }

    botoesNav.forEach(btn => {
