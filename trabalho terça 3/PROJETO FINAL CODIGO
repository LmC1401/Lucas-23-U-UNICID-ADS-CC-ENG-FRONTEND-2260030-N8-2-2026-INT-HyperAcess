
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="HyperAcess - Mapeamento urbano inclusivo de São Paulo, extremos e ABC Paulista para pessoas com deficiência, mobilidade reduzida e idosos.">
  <meta name="theme-color" content="#1a73e8">
  <title>HyperAcess - Mapeamento Urbano Inclusivo de São Paulo e ABC</title>

  <!-- Aplica as preferências salvas (contraste, daltonismo, fonte) antes de desenhar a página -->
  <script>
    try {
      var pref = JSON.parse(localStorage.getItem('hyperacess-prefs') || '{}');
      if (pref.contraste) document.documentElement.classList.add('alto-contraste');
      if (pref.daltonismo) document.documentElement.classList.add('daltonismo');
      if (pref.escala) document.documentElement.style.fontSize = (pref.escala * 100) + '%';
    } catch (e) {}
  </script>

  <!-- Biblioteca Leaflet.js para o mapa de satélite -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

  <style>
    /* ==========================================================================
       1. VARIÁVEIS E CONFIGURAÇÕES GERAIS (WCAG)
       ========================================================================== */
    :root {
      --bg-color: #ffffff;
      --bg-surface: #f8fafc;
      --text-color: #0f172a;
      --text-muted: #475569;
      --border: #94a3b8;
      --primary-color: #1a5fc7;   /* azul com contraste AA para texto branco */
      --primary-hover: #154c9f;
      --on-primary: #ffffff;
      --focus-outline: #f59e0b;
      --sucesso: #047857;
      --perigo: #b91c1c;

      --cor-buraco: #dc2626;
      --cor-alagamento: #2563eb;
      --cor-recape: #b45309;
      --cor-acessibilidade: #7e22ce;
      --cor-sinalizacao: #0f766e;
      --cor-barreira: #be185d;

      --font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      --font-base: 1.125rem;
      --line-height: 1.65;
    }

    html.alto-contraste {
      --bg-color: #000000;
      --bg-surface: #111111;
      --text-color: #ffffff;
      --text-muted: #e5e7eb;
      --border: #ffffff;
      --primary-color: #ffff00;
      --primary-hover: #ffd700;
      --on-primary: #000000;
      --focus-outline: #00ffff;
      --sucesso: #4ade80;
      --perigo: #f87171;
    }

    /* Paleta Okabe-Ito, segura para daltonismo */
    html.daltonismo {
      --cor-buraco: #d55e00;
      --cor-alagamento: #0072b2;
      --cor-recape: #e69f00;
      --cor-acessibilidade: #cc79a7;
      --cor-sinalizacao: #009e73;
      --cor-barreira: #56b4e9;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-color);
      color: var(--text-color);
      font-family: var(--font-family);
      font-size: var(--font-base);
      line-height: var(--line-height);
      transition: background-color 0.3s, color 0.3s;
    }
    body.menu-aberto { overflow: hidden; }

    img, video, iframe { max-width: 100%; }
    a { color: var(--primary-color); }
    html.alto-contraste a { color: #ffff00; }
    button, input, select, textarea { font-family: inherit; }
    h1, h2, h3, h4, p, li, td { overflow-wrap: break-word; }

    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }

    a:focus, button:focus, input:focus, select:focus, textarea:focus, summary:focus, [tabindex]:focus {
      outline: 4px solid var(--focus-outline) !important;
      outline-offset: 3px;
    }
    main:focus, section:focus { outline: none !important; }

    /* Link de atalho: escondido com transform (não deixa faixa no celular) */
    .link-atalho {
      position: absolute; top: 0; left: 10px; transform: translateY(-200%);
      background: var(--focus-outline); color: #000; padding: 10px 18px; font-weight: bold;
      z-index: 9999; border-radius: 6px; transition: transform 0.2s ease;
    }
    .link-atalho:focus { transform: translateY(10px); }

    /* ==========================================================================
       2. BARRA DE ACESSIBILIDADE E CABEÇALHO
       ========================================================================== */
    .barra-acessibilidade {
      background-color: #202124; color: #fff; padding: 0.6rem 2rem;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;
    }
    .marca-sistema { font-weight: 600; }
    .controles-acessibilidade { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }

    .btn-acessivel {
      background-color: #3c4043; color: #fff; border: 2px solid #5f6368;
      padding: 0.4rem 0.8rem; min-height: 44px; min-width: 44px; font-weight: 600; font-size: 1rem;
      cursor: pointer; border-radius: 6px; transition: background-color 0.2s;
    }
    .btn-acessivel:hover { background-color: #5f6368; }
    .btn-acessivel[aria-pressed="true"] { background-color: var(--focus-outline); color: #000; border-color: var(--focus-outline); }

    header.header-principal {
      background-color: var(--primary-color); color: var(--on-primary); padding: 1rem 2rem;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;
    }
    header.header-principal h1 { font-size: 1.7rem; line-height: 1.2; }
    .saudacao { display: block; font-size: 0.9rem; font-weight: normal; opacity: 0.95; }

    .nav-principal ul { display: flex; list-style: none; gap: 0.3rem; flex-wrap: wrap; }
    .nav-principal a {
      display: inline-block; color: inherit; font-weight: 600; font-size: 0.95rem; text-decoration: none;
      padding: 8px 10px; border-radius: 6px; transition: background 0.2s; min-height: 44px; line-height: 28px;
    }
    .nav-principal a:hover { background-color: rgba(255,255,255,0.18); text-decoration: underline; }
    .nav-principal a[aria-current="page"] { background-color: rgba(255,255,255,0.3); text-decoration: underline; }
    html.alto-contraste .nav-principal a[aria-current="page"] { background: #000; color: #ffff00; }

    /* Botão do menu do celular */
    .btn-menu {
      display: none; align-items: center; gap: 0.5rem; background: #fff; color: #1a5fc7;
      border: none; border-radius: 8px; padding: 0.5rem 0.9rem; min-height: 48px; font-weight: 700; font-size: 1rem; cursor: pointer;
    }
    html.alto-contraste .btn-menu { background: #000; color: #ffff00; border: 2px solid #ffff00; }
    .icone-menu, .icone-menu::before, .icone-menu::after {
      display: block; width: 22px; height: 3px; background: currentColor; border-radius: 2px; position: relative;
    }
    .icone-menu::before, .icone-menu::after { content: ""; position: absolute; left: 0; }
    .icone-menu::before { top: -7px; }
    .icone-menu::after { top: 7px; }

    /* ==========================================================================
       3. GAVETA DO CELULAR (abre pelo canto superior direito)
       ========================================================================== */
    .gaveta-fundo {
      position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 10001;
      opacity: 0; visibility: hidden; transition: opacity 0.25s, visibility 0.25s;
    }
    .gaveta-fundo.aberta { opacity: 1; visibility: visible; }
    .gaveta {
      position: fixed; top: 0; right: 0; width: min(88vw, 380px); height: 100%; height: 100dvh;
      background: var(--bg-color); color: var(--text-color); z-index: 10002;
      display: flex; flex-direction: column; box-shadow: -6px 0 24px rgba(0,0,0,0.35);
      border-bottom-left-radius: 16px; transform: translateX(100%); visibility: hidden;
      transition: transform 0.3s ease, visibility 0.3s;
    }
    .gaveta.aberta { transform: none; visibility: visible; }
    .gaveta-topo {
      display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem;
      background: var(--primary-color); color: var(--on-primary);
    }
    .btn-fechar {
      background: #fff; color: #1a5fc7; border: none; border-radius: 8px;
      min-width: 48px; min-height: 48px; font-size: 1.6rem; font-weight: bold; cursor: pointer;
    }
    .gaveta-conteudo { overflow-y: auto; padding: 1rem; flex: 1; }
    .gaveta-titulo { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin: 0.25rem 0 0.6rem; }
    .gaveta-acess { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 1.25rem; }
    .gaveta-acess .btn-acessivel { width: 100%; }
    .gaveta-acess .largo { grid-column: 1 / -1; }
    .gaveta nav ul { list-style: none; }
    .gaveta nav a {
      display: flex; align-items: center; gap: 0.75rem; min-height: 48px; padding: 0.55rem 0.75rem;
      border-radius: 8px; color: var(--text-color); text-decoration: none; font-weight: 600;
    }
    .gaveta nav a:hover { background: var(--bg-surface); }
    .gaveta nav a[aria-current="page"] { background: var(--primary-color); color: var(--on-primary); }

    /* ==========================================================================
       4. PÁGINAS (SPA), HERO E LAYOUT
       ========================================================================== */
    .pagina-modulo { display: none; }
    .pagina-modulo.ativa { display: block; animation: fadeIn 0.25s ease-in-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

    .hero {
      background-color: var(--bg-surface); padding: 3rem 2rem; text-align: center;
      border-bottom: 3px solid var(--primary-color); border-radius: 12px;
    }
    .hero h2 { font-size: 2.1rem; margin-bottom: 1rem; font-weight: 700; line-height: 1.25; }
    .hero p { max-width: 800px; margin: 0 auto 1.5rem auto; font-size: 1.15rem; color: var(--text-muted); }

    main { max-width: 1200px; margin: 2rem auto; padding: 0 1.5rem; }
    main h2 { font-size: 1.7rem; line-height: 1.3; margin-bottom: 0.75rem; }
    main h3 { font-size: 1.25rem; line-height: 1.3; margin-bottom: 0.5rem; }
    .secao { margin-top: 2rem; }
    .texto-apoio { color: var(--text-muted); }
    .aviso { border: 2px solid var(--border); border-radius: 10px; padding: 0.9rem 1rem; margin: 1rem 0; background: var(--bg-surface); font-size: 1rem; }

    .grid-home { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; }
    .grid-home > * { min-width: 0; }
    .grid-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; }
    .card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.2rem; transition: box-shadow 0.2s; }
    .card:hover { box-shadow: 0 4px 14px rgba(0,0,0,0.12); }
    .numeros { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1rem; }
    .numero strong { display: block; font-size: 2rem; line-height: 1.1; color: var(--primary-color); }

    .btn-cta, .btn {
      display: inline-block; background-color: var(--primary-color); color: var(--on-primary);
      padding: 0.85rem 1.6rem; text-decoration: none; font-weight: bold; border-radius: 8px; min-height: 48px;
      border: 2px solid var(--primary-color); cursor: pointer; font-size: 1rem; transition: background-color 0.2s;
    }
    .btn-cta:hover, .btn:hover { background-color: var(--primary-hover); }
    .btn-sec { background: var(--bg-color); color: var(--primary-color); }
    .btn-sec:hover { background: var(--bg-surface); }
    .btn-perigo { background: var(--perigo); border-color: var(--perigo); color: #fff; }
    .btn:disabled { opacity: 0.55; cursor: not-allowed; }
    .grupo-botoes { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }

    .chip {
      background: var(--bg-color); color: var(--text-color); border: 2px solid var(--border); padding: 0.45rem 0.95rem;
      border-radius: 999px; font-size: 0.95rem; font-weight: 600; cursor: pointer; min-height: 44px; transition: background 0.2s;
    }
    .chip:hover { background: var(--bg-surface); }
    .chip[aria-pressed="true"] { background: var(--primary-color); color: var(--on-primary); border-color: var(--primary-color); }

    /* ==========================================================================
       5. MAPAS
       ========================================================================== */
    .mapa-box {
      background-color: var(--bg-surface); border: 1px solid var(--border); border-radius: 12px;
      padding: 1.5rem; margin-bottom: 2rem;
    }
    .barra-chips { display: flex; gap: 0.5rem; margin: 0.75rem 0; flex-wrap: wrap; }
    .mapa-satelite-container {
      width: 100%; height: 560px; border-radius: 10px; border: 2px solid var(--border);
      margin-top: 1rem; z-index: 1; position: relative; background: #dfe7ee;
    }
    .mapa-pequeno { height: 380px; }
    .mapa-erro { display: grid; place-items: center; text-align: center; padding: 1rem; font-weight: 700; color: #0f172a; }
    .marcador {
      display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%;
      border: 3px solid #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.6);
      color: #fff; font: 700 13px/1 Arial, sans-serif; text-shadow: 0 0 3px #000, 0 0 2px #000;
    }
    .legenda { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; list-style: none; margin-top: 0.75rem; font-size: 0.95rem; }
    .legenda li { display: flex; align-items: center; gap: 0.4rem; }
    .legenda .marcador { width: 24px; height: 24px; font-size: 11px; border-width: 2px; }
    .opcao { display: flex; align-items: center; gap: 0.5rem; min-height: 44px; cursor: pointer; }
    .opcao input { width: 22px; height: 22px; accent-color: var(--primary-color); flex: none; }

    /* Cards de ocorrência */
    .card-problema {
      border: 1px solid var(--border); border-left-width: 8px; border-radius: 10px;
      padding: 1rem 1.2rem; margin-bottom: 0.9rem; background-color: var(--bg-surface);
    }
    .card-problema.buraco { border-left-color: var(--cor-buraco); }
    .card-problema.alagamento { border-left-color: var(--cor-alagamento); }
    .card-problema.recape { border-left-color: var(--cor-recape); }
    .card-problema.acessibilidade { border-left-color: var(--cor-acessibilidade); }
    .card-problema.semaforo { border-left-color: var(--cor-sinalizacao); }
    .card-problema.barreira { border-left-color: var(--cor-barreira); }
    .risco { display: inline-block; font-size: 0.8rem; font-weight: 700; padding: 0.15rem 0.55rem; border-radius: 999px; border: 2px solid currentColor; margin-left: 0.3rem; }
    .risco.alta { color: var(--perigo); }
    .risco.media { color: #b45309; }
    .risco.baixa { color: var(--sucesso); }
    html.alto-contraste .risco.media { color: #fbbf24; }
    .card-problema h3, .card-problema h4 { font-size: 1.1rem; margin: 0.2rem 0 0.3rem; }
    .meta { display: flex; flex-wrap: wrap; gap: 0.2rem 1.2rem; font-size: 0.95rem; color: var(--text-muted); margin-top: 0.4rem; }
    .tag-status {
      display: inline-block; padding: 0.2rem 0.6rem; font-size: 0.8rem; font-weight: 700;
      text-transform: uppercase; background: #e2e8f0; color: #1e293b; border-radius: 20px; margin-bottom: 0.3rem;
    }
    .btn-falar-msg {
      background: none; border: none; cursor: pointer; font-size: 0.95rem; margin-top: 0.4rem; font-weight: 600;
      color: var(--primary-color); text-decoration: underline; min-height: 40px; padding: 0.2rem 0;
    }

    /* ==========================================================================
       6. FORMULÁRIOS (validação com mensagem e borda em destaque)
       ========================================================================== */
    .form-container {
      background-color: var(--bg-surface); border: 1px solid var(--border); padding: 2rem;
      border-radius: 12px; margin-top: 1rem;
    }
    .campo-form { margin-bottom: 1.1rem; }
    .campo-form label, .campo-form legend { display: block; font-weight: 600; margin-bottom: 0.4rem; }
    .campo-form input:not([type="checkbox"]):not([type="radio"]), .campo-form select, .campo-form textarea {
      width: 100%; padding: 0.8rem; font-size: 1rem; border: 2px solid var(--border); min-height: 48px;
      border-radius: 8px; background-color: var(--bg-color); color: var(--text-color);
    }
    fieldset.campo-form { border: none; }
    .campo-form .erro-input, .campo-form [aria-invalid="true"] {
      border: 3px solid var(--perigo) !important; background-color: #fef2f2 !important; color: #0f172a !important;
    }
    .erro-campo { color: var(--perigo); font-weight: 700; font-size: 0.95rem; margin-top: 0.3rem; }
    .dica { color: var(--text-muted); font-size: 0.95rem; margin-top: 0.3rem; }
    .duas-colunas { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
    .duas-colunas > * { min-width: 0; }
    .btn-submit {
      width: 100%; background-color: var(--primary-color); color: var(--on-primary); padding: 0.9rem;
      font-size: 1.05rem; font-weight: 700; border: none; border-radius: 8px; cursor: pointer; min-height: 48px;
      transition: background-color 0.2s;
    }
    .btn-submit:hover { background-color: var(--primary-hover); }
    .status-rascunho { font-size: 0.95rem; color: var(--text-muted); margin-top: 0.6rem; min-height: 1.4em; }
    .status-api-box { margin-top: 1rem; padding: 1rem; border-radius: 8px; font-weight: 600; }
    .status-api-box[hidden] { display: none; }
    .status-api-box.sucesso { background-color: #d1fae5; color: #065f46; border: 2px solid #10b981; }
    .status-api-box.erro { background-color: #fee2e2; color: #991b1b; border: 2px solid #ef4444; }
    .status-api-box.carregando { background-color: #e0f2fe; color: #075985; border: 2px solid #0284c7; }

    .tabela-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; margin-top: 0.75rem; }
    table { width: 100%; border-collapse: collapse; font-size: 1rem; }
    th, td { padding: 0.65rem; text-align: left; border-bottom: 1px solid var(--border); vertical-align: top; }
    th { background: var(--primary-color); color: var(--on-primary); }

    details.faq { border: 1px solid var(--border); border-radius: 10px; background: var(--bg-surface); margin-bottom: 0.7rem; }
    details.faq summary { cursor: pointer; font-weight: 700; padding: 1rem; min-height: 48px; }
    details.faq > div { padding: 0 1rem 1rem; }
    details.faq ol, details.faq ul { padding-left: 1.4rem; }

    /* Rotas e alertas */
    .rota { border: 2px solid var(--border); border-radius: 10px; padding: 1rem; margin-top: 0.8rem; background: var(--bg-surface); }
    .rota.melhor { border-color: var(--sucesso); border-width: 3px; }
    .selo { display: inline-block; font-size: 0.85rem; font-weight: 700; padding: 0.15rem 0.6rem; border-radius: 999px; background: var(--sucesso); color: #fff; }
    .selo.atencao { background: #b45309; }
    .painel-alerta { border: 4px solid var(--border); border-radius: 12px; padding: 1.4rem; text-align: center; background: var(--bg-surface); margin: 1rem 0; }
    .painel-alerta .titulo-alerta { font-size: 1.45rem; font-weight: 800; }
    .painel-alerta.ok { border-color: var(--sucesso); }
    .painel-alerta.perigo { background: #b91c1c; color: #fff; border-color: #000; animation: piscar 0.8s steps(2, start) 5; }
    @keyframes piscar { to { background: #000; } }
    .progresso { width: 100%; height: 14px; accent-color: var(--primary-color); }
    .log { list-style: none; max-height: 220px; overflow-y: auto; }
    .log li { padding: 0.4rem 0; border-bottom: 1px solid var(--border); font-size: 0.98rem; }

    /* Multimídia */
    .midia-video { width: 100%; max-width: 860px; height: auto; border-radius: 10px; border: 2px solid var(--border); background: #000; display: block; }
    .midia-audio { width: 100%; max-width: 520px; }
    .iframe-mapa { width: 100%; height: 320px; border: 2px solid var(--border); border-radius: 10px; }

    /* ==========================================================================
       7. CHATBOT (FAQ em JavaScript, sem chave de API)
       ========================================================================== */
    .chatbot-widget { position: fixed; bottom: 20px; right: 20px; z-index: 10000; }
    .btn-toggle-chat {
      background-color: var(--primary-color); color: var(--on-primary); border: 3px solid #fff; border-radius: 50px;
      padding: 0.75rem 1.3rem; font-weight: 700; font-size: 1rem; cursor: pointer; min-height: 52px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.3); display: flex; align-items: center; gap: 0.5rem;
    }
    .chat-box {
      width: min(380px, calc(100vw - 32px)); height: min(520px, calc(100vh - 110px));
      background-color: var(--bg-color); border: 2px solid var(--primary-color); border-radius: 14px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25); display: flex; flex-direction: column;
      position: absolute; bottom: 66px; right: 0; overflow: hidden;
    }
    .chat-box[hidden] { display: none; }
    .chat-header {
      background-color: var(--primary-color); color: var(--on-primary); padding: 0.6rem 0.8rem;
      display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    }
    .chat-header h2 { font-size: 1.05rem; margin: 0; }
    .chat-messages { flex: 1; padding: 0.9rem; overflow-y: auto; display: flex; flex-direction: column; gap: 0.7rem; }
    .mensagem-chat { padding: 0.65rem 0.9rem; border-radius: 10px; max-width: 90%; line-height: 1.45; font-size: 1rem; }
    .mensagem-chat.bot { background: #e2e8f0; color: #0f172a; border-left: 4px solid #1a5fc7; align-self: flex-start; }
    .mensagem-chat.bot a { color: #154c9f; font-weight: 700; }
    .mensagem-chat.bot .btn-falar-msg { color: #154c9f; }
    .mensagem-chat.user { background: var(--primary-color); color: var(--on-primary); align-self: flex-end; }
    .sugestoes-chat { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0 0.8rem 0.5rem; }
