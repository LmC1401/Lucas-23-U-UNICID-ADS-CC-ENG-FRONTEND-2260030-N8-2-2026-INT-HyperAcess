    var rad = Math.PI / 180, kx = Math.cos(lat * rad) * 111320, ky = 110540, melhor = Infinity;
    for (var i = 0; i < linha.length - 1; i++) {
      var ax = (linha[i][1] - lng) * kx, ay = (linha[i][0] - lat) * ky;
      var bx = (linha[i + 1][1] - lng) * kx, by = (linha[i + 1][0] - lat) * ky;
      var dx = bx - ax, dy = by - ay, l2 = dx * dx + dy * dy;
      var t = l2 ? Math.max(0, Math.min(1, -(ax * dx + ay * dy) / l2)) : 0;
      var px = ax + t * dx, py = ay + t * dy;
      var d = Math.sqrt(px * px + py * py);
