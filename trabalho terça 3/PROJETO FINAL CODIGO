/* Página 9 — Busca nas perguntas frequentes */
document.addEventListener('DOMContentLoaded', function () {
  var campo = document.getElementById('busca-faq');
  var saida = document.getElementById('resultado-busca');
  function normalizar(t) { return t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); }
  var timer;
  campo.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () {
      var termo = normalizar(campo.value.trim()), total = 0;
      document.querySelectorAll('.grupo-faq').forEach(function (grupo) {
        var visiveis = 0;
        grupo.querySelectorAll('details.faq').forEach(function (d) {
          var achou = !termo || normalizar(d.textContent).indexOf(termo) > -1;
          d.hidden = !achou;
          if (termo) d.open = achou;
          else d.open = false;
          if (achou) visiveis++;
        });
        grupo.hidden = visiveis === 0;
        total += visiveis;
      });
      saida.textContent = termo ? (total ? total + ' pergunta(s) encontrada(s).' : 'Nenhuma pergunta encontrada. Tente outra palavra ou fale conosco.') : '';
    }, 250);
  });
});


