/* ==========================================================================
   3. GAVETA DE NAVEGAÇÃO (CELULAR) — sai do canto superior direito
   ========================================================================== */
.gaveta-fundo {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s, visibility 0.25s;
}
.gaveta-fundo.aberta { opacity: 1; visibility: visible; }

.gaveta {
  position: fixed;
  top: 0;
  right: 0;
  width: min(88vw, 380px);
  height: 100%;
  height: 100dvh;
  background: var(--bg-color);
  color: var(--text-color);
  z-index: 1001;
  display: flex;
  flex-direction: column;
  box-shadow: -6px 0 24px rgba(0, 0, 0, 0.35);
  border-left: 4px solid var(--primary-color);
  border-bottom-left-radius: 16px;
  transform: translate(100%, -12%) scale(0.96);
  transform-origin: top right;
  opacity: 0;
  visibility: hidden;
  transition: transform 0.3s ease, opacity 0.3s ease, visibility 0.3s;
}
.gaveta.aberta {
  transform: none;
  opacity: 1;
