      });
    })();

    /* ==========================================================================
       11. PREFEITURAS, CONTATO, VOLUNTARIADO E APOIO
       ========================================================================== */
    $('lista-orgaos').innerHTML = ORGAOS.map(function (o) {
      return '<div class="card"><h4>' + escapar(o.nome) + '</h4><p>' + escapar(o.area) + '</p></div>';
    }).join('');
    function desenharPainel() { // tabela de ocorrências por região e tipo (dados para planejar obras)
      var tipos = Object.keys(TIPOS);
      $('cab-painel').innerHTML = '<th scope="col">Região</th>' + tipos.map(function (t) { return '<th scope="col">' + TIPOS[t].nome + '</th>'; }).join('') + '<th scope="col">Risco alto</th><th scope="col">Total</th>';
      $('corpo-painel').innerHTML = REGIOES.filter(function (r) { return r.id !== 'todas'; }).map(function (r) {
        var daRegiao = ocorrencias().filter(function (o) { return o.zona === r.id; });
        var nome = r.nome.replace(/^\S+\s/, '');
        return '<tr><th scope="row" data-rotulo="Região">' + nome + '</th>' + tipos.map(function (t) {
          return '<td data-rotulo="' + TIPOS[t].nome + '">' + daRegiao.filter(function (o) { return o.tipo === t; }).length + '</td>';
        }).join('') + '<td data-rotulo="Risco alto">' + daRegiao.filter(function (o) { return o.risco === 'alta'; }).length + '</td><td data-rotulo="Total"><strong>' + daRegiao.length + '</strong></td></tr>';
      }).join('');
    }

    function formSimples(id, chave, msgId, sucesso, extra) {
      var f = $(id); if (f.elements.nome) f.elements.nome.value = perfil.nome || '';
      if (f.elements.email) f.elements.email.value = perfil.email || '';
      var r = ativarRascunho(f, chave);
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!validarFormulario(f)) return;
        if (extra && extra(f) === false) return;
        var protocolo = Math.floor(10000 + Math.random() * 89999);
        mensagem(msgId, 'sucesso', '✅ ' + sucesso(f) + ' Protocolo ' + protocolo + '.');
        anunciar(sucesso(f));
        r.limpar();
      });
      return f;
    }
    formSimples('form-orgao', 'orgao', 'msg-orgao', function (f) { return 'Manifestação de interesse de ' + escapar(f.elements.orgao.value.trim()) + ' recebida. Nossa equipe retornará pelo e-mail institucional.'; });
    $('orgao-resp').value = ''; $('orgao-email').value = ''; // formulário institucional não usa os dados do cidadão
    var fc = formSimples('form-contato', 'contato', 'msg-contato', function () { return 'Mensagem enviada à administração. Resposta em até 5 dias úteis.'; });
    fc.elements.mensagem.addEventListener('input', function () { $('f-contador').textContent = this.value.length + ' de 1000 caracteres'; });
    formSimples('form-voluntario', 'voluntario', 'msg-voluntario', function (f) { return 'Inscrição recebida! Vamos combinar um mutirão em ' + escapar(f.elements.bairro.value.trim()) + '.'; });
    formSimples('form-apoio', 'apoio', 'msg-apoio', function (f) {
      var v = f.elements.valor.value === 'outro' ? Number(f.elements.outro.value) : Number(f.elements.valor.value);
      return 'Obrigado! Intenção de apoio de R$ ' + v.toFixed(2).replace('.', ',') + ' registrada (simulação, nada foi cobrado).';
    });
    function alternarOutro() { var mostrar = $('a-valor').value === 'outro'; $('campo-outro').hidden = !mostrar; $('a-outro').required = mostrar; }
    $('a-valor').addEventListener('change', alternarOutro);
    alternarOutro();

    /* ==========================================================================
       12. HOME: números, recentes e filtro de notícias; FAQ com busca
       ========================================================================== */
    function atualizarNumeros() {
      $('n-ocorrencias').textContent = ocorrencias().length;
      $('n-regioes').textContent = REGIOES.length - 1;
      $('n-chamados').textContent = meusChamados.length + CHAMADOS_BASE.length;
    }
    $('lista-recentes').innerHTML = OCORRENCIAS_BASE.slice(0, 3).map(function (o) {
      return '<article class="card-problema ' + o.tipo + '"><span class="tag-status">' + TIPOS[o.tipo].nome + '</span><h4>' + escapar(o.titulo) + '</h4><p>' + escapar(o.desc) + '</p>' +
        '<button type="button" class="btn-falar-msg" data-falar="' + escapar(o.titulo + '. ' + o.desc) + '">🔊 Ouvir alerta</button></article>';
    }).join('');
    document.addEventListener('click', function (e) { var b = e.target.closest('[data-falar]'); if (b) falarTexto(b.getAttribute('data-falar')); });

    function filtrarNoticias(cat) {
      var n = 0;
      document.querySelectorAll('.noticia').forEach(function (a) { var ok = cat === 'todas' || a.getAttribute('data-categoria') === cat; a.hidden = !ok; if (ok) n++; });
      document.querySelectorAll('[data-noticia]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-noticia') === cat)); });
      $('contagem-noticias').textContent = n + (n === 1 ? ' notícia.' : ' notícias.');
      gravar('hyperacess-filtro-noticias', cat);
    }
    document.querySelectorAll('[data-noticia]').forEach(function (b) { b.addEventListener('click', function () { filtrarNoticias(b.getAttribute('data-noticia')); }); });
    filtrarNoticias(ler('hyperacess-filtro-noticias', 'todas'));

    $('busca-faq').addEventListener('input', function () {
      var termo = this.value.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim(), n = 0;
      document.querySelectorAll('#lista-faq details').forEach(function (d) {
        var ok = !termo || d.textContent.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').indexOf(termo) > -1;
        d.hidden = !ok; d.open = !!termo && ok; if (ok) n++;
      });
      $('resultado-faq').textContent = termo ? n + ' resultado(s).' : '';
    });

    /* ==========================================================================
       13. CHATBOT (respostas por palavras-chave, sem chave de API)
       ========================================================================== */
    var BASE_CHAT = [
      { chaves: ['chamado', 'relatar', 'registrar', 'buraco', 'problema', 'reportar'], resp: 'Para registrar um problema, abra a Central de Chamados, preencha os campos e envie. Você recebe um protocolo.', link: '#pag-4' },
      { chaves: ['mapa', 'onde', 'regiao', 'zona', 'abc', 'satelite'], resp: 'O Mapa de Riscos cobre todas as zonas, os extremos e o ABC. Escolha uma região e filtre por tipo.', link: '#pag-3' },
      { chaves: ['rota', 'caminho', 'trajeto', 'chegar', 'ir'], resp: 'No Planejador de Rotas Acessíveis você define partida e chegada, e o sistema avisa quais ruas têm problemas relatados.', link: '#pag-5' },
      { chaves: ['gps', 'alerta', 'alarme', 'som', 'vibracao', 'localizacao'], resp: 'No Sistema de Lembretes e Alertas, o GPS avisa antes de cada obstáculo com aviso visual e sonoro. Use "Testar alerta" para conferir.', link: '#pag-6' },
      { chaves: ['contraste', 'letra', 'fonte', 'daltonismo', 'cor', 'enxergar', 'ouvir', 'leitor'], resp: 'Use Contraste, Daltonismo, A+ e A- na barra do topo (no celular, dentro do Menu). "Ouvir Página" lê o conteúdo em voz alta.', link: '#pag-9' },
      { chaves: ['perfil', 'cadastro', 'nome', 'cadeirante', 'idoso', 'cego'], resp: 'Em Perfil e Acessibilidade você informa seus dados e preferências: contraste, letra maior e como quer receber os alertas.', link: '#pag-7' },
      { chaves: ['prefeitura', 'subprefeitura', 'orgao', 'reclamacao', '156'], resp: 'A Área Institucional é para prefeituras e órgãos públicos demonstrarem interesse e verem os dados mapeados. Cidadãos com urgências devem ligar 156.', link: '#pag-8' },
      { chaves: ['voluntario', 'ajudar', 'participar', 'doar', 'doacao', 'apoiar'], resp: 'Na página Contato você pode se inscrever como voluntário ou registrar uma intenção de apoio.', link: '#pag-10' },
      { chaves: ['contato', 'email', 'falar', 'sugestao', 'critica'], resp: 'Use o Fale Conosco para enviar feedbacks, sugestões de melhoria ou pedir suporte.', link: '#pag-10' }
    ];
    var SUGESTOES = ['Como relato um buraco?', 'Como ativo o GPS?', 'Como aumento a letra?', 'Quero ser voluntário'];
    function responder(texto) {
      var palavras = texto.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').split(/\W+/);
      var melhor = null, pontos = 0;
      BASE_CHAT.forEach(function (item) {
        var p = palavras.filter(function (w) { return w.length > 1 && item.chaves.some(function (c) { return w === c || (w.length > 3 && c.indexOf(w) === 0); }); }).length;
        if (p > pontos) { pontos = p; melhor = item; }
      });
      return melhor || { resp: 'Ainda não sei responder isso. Veja a Central de Ajuda (FAQ) ou escreva no Fale Conosco.', link: '#pag-9' };
    }
    function msgChat(texto, autor, link) {
      var div = document.createElement('div');
      div.className = 'mensagem-chat ' + autor;
      div.appendChild(document.createTextNode(texto));
      if (link) {
        var a = document.createElement('a'); a.href = link; a.textContent = ' Ir para a página';
        div.appendChild(document.createElement('br')); div.appendChild(a);
        var b = document.createElement('button'); b.type = 'button'; b.className = 'btn-falar-msg'; b.textContent = '🔊 Ouvir';
        b.addEventListener('click', function () { falarTexto(texto); });
        div.appendChild(document.createElement('br')); div.appendChild(b);
      }
      $('chat-messages').appendChild(div);
      $('chat-messages').scrollTop = $('chat-messages').scrollHeight;
    }
    function perguntar(t) { msgChat(t, 'user'); var r = responder(t); msgChat(r.resp, 'bot', r.link); }
    function abrirChat() {
      $('box-chatbot').hidden = false; $('btn-chat').setAttribute('aria-expanded', 'true');
      if (!$('chat-messages').children.length) msgChat('Olá! Sou o assistente do HyperAcess. Pergunte sobre chamados, mapa, rotas, GPS ou acessibilidade.', 'bot');
      $('chat-user-input').focus();
    }
    function fecharChat() { $('box-chatbot').hidden = true; $('btn-chat').setAttribute('aria-expanded', 'false'); $('btn-chat').focus(); }
    $('btn-chat').addEventListener('click', function () { $('box-chatbot').hidden ? abrirChat() : fecharChat(); });
    $('btn-fechar-chat').addEventListener('click', fecharChat);
    $('box-chatbot').addEventListener('keydown', function (e) { if (e.key === 'Escape') fecharChat(); });
    $('chat-messages').addEventListener('click', function (e) { if (e.target.closest('a')) fecharChat(); });
    $('sugestoes-chat').innerHTML = SUGESTOES.map(function (s) { return '<button type="button" class="chip">' + s + '</button>'; }).join('');
    $('sugestoes-chat').addEventListener('click', function (e) { if (e.target.closest('button')) perguntar(e.target.textContent); });
    $('form-chat').addEventListener('submit', function (e) {
      e.preventDefault();
      var t = $('chat-user-input').value.trim();
      if (!t) { anunciar('Digite uma pergunta.'); return; }
      perguntar(t); $('chat-user-input').value = '';
    });

    /* ==========================================================================
       14. INICIALIZAÇÃO
       ========================================================================== */
    aplicarPrefs();
    atualizarSaudacao();
    desenharLegenda();
    renderizarPinosNoMapa();
    renderizarChamados();
    atualizarNumeros();
    desenharPainel();
    aplicarAlertasDoPerfil();
    navegarPara(location.hash.indexOf('#pag-') === 0 ? location.hash.slice(1) : 'pag-1', false);
    if (voz) voz.getVoices();
  })();
  </script>
</body>
</html>
