    function desenharFrameVideo(tempo) {
      if (!ctxVideo) return;
      const w = canvasVideo.width;
      const h = canvasVideo.height;

      // Fundo estilo globo/satélite
      const grad = ctxVideo.createLinearGradient(0, 0, w, h);
      grad.addColorStop(0, '#061426');
      grad.addColorStop(0.5, '#0A2540');
      grad.addColorStop(1, '#0E3B66');
      ctxVideo.fillStyle = grad;
      ctxVideo.fillRect(0, 0, w, h);

      // Grade geográfica decorativa
      ctxVideo.strokeStyle = 'rgba(56, 189, 248, 0.14)';
      ctxVideo.lineWidth = 1;
      for (let x = 0; x < w; x += 60) {
        ctxVideo.beginPath();
        ctxVideo.moveTo(x, 0);
        ctxVideo.lineTo(x, h);
        ctxVideo.stroke();
      }
      for (let y = 0; y < h; y += 60) {
        ctxVideo.beginPath();
        ctxVideo.moveTo(0, y);
        ctxVideo.lineTo(w, y);
        ctxVideo.stroke();
      }

      const idxCena = Math.min(cenasVideo.length - 1, Math.floor(tempo / 6));
      const cena = cenasVideo[idxCena];

      // Círculo radar animado
      const raio = 45 + ((tempo * 25) % 45);
      ctxVideo.beginPath();
      ctxVideo.arc(w / 2, h / 2 - 20, raio, 0, Math.PI * 2);
      ctxVideo.strokeStyle = cena.corDestaque;
      ctxVideo.lineWidth = 4;
      ctxVideo.stroke();

      // Pino central
      ctxVideo.fillStyle = cena.corDestaque;
      ctxVideo.beginPath();
      ctxVideo.arc(w / 2, h / 2 - 20, 22, 0, Math.PI * 2);
      ctxVideo.fill();

      ctxVideo.fillStyle = '#FFFFFF';
      ctxVideo.font = 'bold 18px Segoe UI, sans-serif';
      ctxVideo.textAlign = 'center';
      ctxVideo.fillText('HA', w / 2, h / 2 - 14);

      // Textos da cena
      ctxVideo.fillStyle = '#FFFFFF';
      ctxVideo.font = 'bold 28px Segoe UI, sans-serif';
      ctxVideo.fillText(cena.titulo, w / 2, 72);

      ctxVideo.fillStyle = '#CBD5E1';
      ctxVideo.font = '18px Segoe UI, sans-serif';
      ctxVideo.fillText(cena.subtitulo, w / 2, 106);

      if (legendaVideoEl) legendaVideoEl.textContent = cena.legenda;
      if (barraVideoFill) barraVideoFill.style.width = ((tempo / duracaoTotalVideo) * 100) + '%';

      const segFormatado = String(Math.floor(tempo)).padStart(2, '0');
      statusVideoAudio.textContent = `${videoRodando ? '▶️ Reproduzindo' : '⏸️ Pausado'} (00:${segFormatado} / 00:24) · ${videoMudo ? 'Mudo' : 'Áudio Ativo'}`;

      // Narração automática por cena quando áudio está ligado
      if (videoRodando && !videoMudo && idxCena !== ultimaCenaFalada && 'speechSynthesis' in window) {
        ultimaCenaFalada = idxCena;
        window.speechSynthesis.cancel();
        const falaCena = new SpeechSynthesisUtterance(cena.legenda);
        falaCena.lang = 'pt-BR';
        falaCena.rate = 1.05;
        window.speechSynthesis.speak(falaCena);
      }
    }

    function alternarPlayPauseVideo() {
      if (videoRodando) {
        videoRodando = false;
        clearInterval(intervaloVideo);
        if ('speechSynthesis' in window) window.speechSynthesis.cancel();
        btnVideoPlayPause.textContent = '▶️ Continuar Vídeo';
        btnVideoPlayPause.setAttribute('aria-pressed', 'false');
        desenharFrameVideo(tempoVideoAtual);
      } else {
