    sel.value = padrao;
  }
  opcoes(selO, 'masp'); opcoes(selD, 'se');

  // Perfil e tipos a evitar vindos do "Meu Perfil"
  var perfilParaRota = { mobilidade: 'cadeirante', visual: 'visual', idoso: 'idoso', auditiva: 'padrao', nenhuma: 'padrao' };
  document.getElementById('rt-perfil').value = perfilParaRota[HA.perfil.tipo] || 'padrao';
  var evitarPerfil = HA.perfil.evitar || [];
  document.getElementById('rt-evitar').innerHTML = Object.keys(D.tipos).map(function (k) {
    return '<label class="opcao"><input type="checkbox" name="evitar" value="' + k + '"' + (evitarPerfil.indexOf(k) > -1 ? ' checked' : '') + '> ' + D.tipos[k].curto + '</label>';
  }).join('');

  document.getElementById('btn-inverter').addEventListener('click', function () {
    var a = selO.value; selO.value = selD.value; selD.value = a;
    var p = pontosLivres.origem; pontosLivres.origem = pontosLivres.destino; pontosLivres.destino = p;
    HA.anunciar('Partida e chegada invertidas.');
  });

  // Clique no mapa define partida/chegada
  var marcadoresAB = {};
  function marcarPonto(qual, latlng) {
    if (!mapa) return;
    if (marcadoresAB[qual]) mapa.removeLayer(marcadoresAB[qual]);
    marcadoresAB[qual] = L.marker(latlng, { icon: HA.iconeClasse('pino', qual === 'origem' ? 'A' : 'B'), title: qual === 'origem' ? 'Partida' : 'Chegada' }).addTo(mapa);
  }
  if (mapa) {
    mapa.on('click', function (e) {
      var qual = document.querySelector('input[name="clique"]:checked').value;
      pontosLivres[qual] = [e.latlng.lat, e.latlng.lng];
      (qual === 'origem' ? selO : selD).value = 'mapa';
      marcarPonto(qual, pontosLivres[qual]);
      HA.anunciar((qual === 'origem' ? 'Ponto de partida' : 'Ponto de chegada') + ' definido no mapa.');
      if (qual === 'origem') document.querySelector('input[name="clique"][value="destino"]').checked = true;
    });
  } else {
    document.getElementById('grupo-clique').hidden = true;
    selO.querySelector('option[value="mapa"]').remove();
    selD.querySelector('option[value="mapa"]').remove();
  }

  function obterGPS() {
    return new Promise(function (ok, erro) {
      if (!navigator.geolocation) return erro(new Error('sem gps'));
      navigator.geolocation.getCurrentPosition(function (p) { ok([p.coords.latitude, p.coords.longitude]); }, erro, { enableHighAccuracy: true, timeout: 10000 });
    });
  }

  async function resolverPonto(sel, qual) {
    var v = sel.value;
    if (v === 'gps') return obterGPS();
    if (v === 'mapa') {
      if (!pontosLivres[qual]) throw new Error('Toque no mapa para escolher o ' + (qual === 'origem' ? 'ponto de partida.' : 'ponto de chegada.'));
      return pontosLivres[qual];
    }
    var l = D.locais.filter(function (x) { return x.id === v; })[0];
    return [l.lat, l.lng];
