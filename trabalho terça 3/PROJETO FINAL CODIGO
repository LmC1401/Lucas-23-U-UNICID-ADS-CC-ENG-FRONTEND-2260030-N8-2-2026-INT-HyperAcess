html.alto-contraste .leaflet-tile-pane { filter: grayscale(1) contrast(1.3) brightness(0.85); }
html.alto-contraste th, html.alto-contraste td { border-color: #fff; }
html.alto-contraste .perfil-opcao input:checked + label { border-color: #ffff00; box-shadow: inset 0 0 0 3px #ffff00; }
html.alto-contraste .estrelas input:checked + label { background: #ffff00; color: #000; border-color: #ffff00; }
html.alto-contraste .numero { border-left-color: #ffff00; }

/* Espaçamento ampliado (dislexia / baixa visão) */
html.espaco-ampliado {
  --line-height: 1.9;
  --espaco-letras: 0.06em;
}
html.espaco-ampliado p, html.espaco-ampliado li { word-spacing: 0.12em; }

/* Alvos de toque maiores (mobilidade / tremores) */
html.alvos-grandes .btn, html.alvos-grandes .btn-acessivel, html.alvos-grandes .btn-submit { min-height: 60px; }
html.alvos-grandes .opcao { min-height: 52px; }
html.alvos-grandes .opcao input { width: 28px; height: 28px; }

/* Sem animações */
html.sem-animacao *, html.sem-animacao *::before, html.sem-animacao *::after {
  transition: none !important;
  animation: none !important;
}

/* ==========================================================================
   10. RESPONSIVIDADE (CELULARES E TABLETS)
   ========================================================================== */
@media (max-width: 1024px) {
  /* Abaixo de 1024px, a navegação passa para a gaveta */
  nav.nav-desktop { display: none; }
  .btn-menu { display: inline-flex; }
  header.header-principal { flex-wrap: nowrap; }
}

@media (max-width: 900px) {
  .grid-home { grid-template-columns: 1fr; }
}

@media (max-width: 768px) {
  /* A barra preta de acessibilidade fica dentro da gaveta no celular */
  .barra-acessibilidade { display: none; }

  header.header-principal {
    padding: 0.75rem 1rem;
    position: sticky;
    top: 0;
    z-index: 900;
  }
