document.addEventListener('DOMContentLoaded', function () {
  var D = window.HA_DADOS;
  var VELOCIDADE = { cadeirante: 3.6, visual: 4.0, idoso: 3.2, padrao: 4.8 }; // km/h
  var LIMITE_PROXIMIDADE = 40; // metros entre a rota e a ocorrência
