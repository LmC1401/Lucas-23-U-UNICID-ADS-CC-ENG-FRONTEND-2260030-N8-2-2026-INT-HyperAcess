/* Página 7 — Perfil do usuário e personalização da interface */
document.addEventListener('DOMContentLoaded', function () {
  var D = window.HA_DADOS;
  var form = document.getElementById('form-perfil');

  var PRESETS = {
    visual:     { prefs: { contraste: true,  escala: 1.3, espaco: true,  alvos: false, semAnimacao: true,  leitura: true,  som: true,  voz: true,  vibracao: true  }, evitar: ['buraco', 'acessibilidade', 'sinalizacao', 'alagamento'] },
    auditiva:   { prefs: { contraste: false, escala: 1,   espaco: false, alvos: false, semAnimacao: false, leitura: false, som: false, voz: false, vibracao: true  }, evitar: ['buraco', 'alagamento'] },
    mobilidade: { prefs: { contraste: false, escala: 1.1, espaco: false, alvos: true,  semAnimacao: false, leitura: false, som: true,  voz: true,  vibracao: true  }, evitar: ['buraco', 'acessibilidade', 'alagamento', 'recapeamento'] },
    idoso:      { prefs: { contraste: false, escala: 1.3, espaco: true,  alvos: true,  semAnimacao: true,  leitura: false, som: true,  voz: true,  vibracao: true  }, evitar: ['buraco', 'acessibilidade', 'alagamento', 'recapeamento'] },
    nenhuma:    { prefs: { contraste: false, escala: 1,   espaco: false, alvos: false, semAnimacao: false, leitura: false, som: true,  voz: true,  vibracao: true  }, evitar: ['alagamento'] }
  };
  var CAMPOS_PREFS = { contraste: 'pf-contraste', espaco: 'pf-espaco', alvos: 'pf-alvos', semAnimacao: 'pf-animacao', leitura: 'pf-leitura', som: 'pf-som', voz: 'pf-voz', vibracao: 'pf-vibracao' };
  var NOMES_NEC = { cadeira: 'cadeira de rodas', andador: 'andador ou muletas', bengala: 'bengala', 'cao-guia': 'cão-guia', 'aparelho-auditivo': 'aparelho auditivo', 'evitar-degraus': 'evitar degraus e ladeiras', pausas: 'pausas no trajeto' };

  document.getElementById('pf-evitar').innerHTML = Object.keys(D.tipos).map(function (k) {
    return '<label class="opcao"><input type="checkbox" name="evitar" value="' + k + '"> ' + D.tipos[k].nome + '</label>';
  }).join('');

  // Cópias de trabalho (só são gravadas ao salvar)
  var perfil = JSON.parse(JSON.stringify(HA.perfil));

  function preencher() {
    ['nome', 'email', 'telefone', 'nascimento', 'bairro', 'contatoEmergencia'].forEach(function (k) { form.elements[k].value = perfil[k] || ''; });
    var r = form.querySelector('input[name="tipo"][value="' + perfil.tipo + '"]'); if (r) r.checked = true;
    form.querySelectorAll('input[name="necessidades"]').forEach(function (c) { c.checked = (perfil.necessidades || []).indexOf(c.value) > -1; });
    form.querySelectorAll('input[name="evitar"]').forEach(function (c) { c.checked = (perfil.evitar || []).indexOf(c.value) > -1; });
    Object.keys(CAMPOS_PREFS).forEach(function (k) { document.getElementById(CAMPOS_PREFS[k]).checked = !!HA.prefs[k]; });
    document.getElementById('pf-escala').value = HA.prefs.escala || 1;
    resumo();
  }

  function lerFormulario() {
    ['nome', 'email', 'telefone', 'nascimento', 'bairro', 'contatoEmergencia'].forEach(function (k) { perfil[k] = form.elements[k].value.trim(); });
    var r = form.querySelector('input[name="tipo"]:checked'); perfil.tipo = r ? r.value : 'nenhuma';
    perfil.necessidades = Array.from(form.querySelectorAll('input[name="necessidades"]:checked')).map(function (c) { return c.value; });
    perfil.evitar = Array.from(form.querySelectorAll('input[name="evitar"]:checked')).map(function (c) { return c.value; });
  }

  function idade(iso) {
    if (!iso) return '';
    var n = new Date(iso), h = new Date(), a = h.getFullYear() - n.getFullYear();
    if (h.getMonth() < n.getMonth() || (h.getMonth() === n.getMonth() && h.getDate() < n.getDate())) a--;
    return isNaN(a) ? '' : a + ' anos';
  }

  function resumo() {
    lerFormulario();
    var p = HA.prefs, itens = [];
    if (p.contraste) itens.push('Alto contraste ligado');
    if ((p.escala || 1) !== 1) itens.push('Texto em ' + Math.round(p.escala * 100) + '%');
    if (p.espaco) itens.push('Espaçamento ampliado');
    if (p.alvos) itens.push('Botões maiores');
    if (p.semAnimacao) itens.push('Sem animações');
    if (p.leitura) itens.push('Resultados lidos em voz alta');
    var alertas = [p.som && 'som', p.voz && 'voz', p.vibracao && 'vibração', 'visual'].filter(Boolean).join(', ');
    var evitar = perfil.evitar.map(function (k) { return D.tipos[k].curto.toLowerCase(); }).join(', ') || 'nada em especial';
    var nec = perfil.necessidades.map(function (k) { return NOMES_NEC[k]; }).join(', ') || 'nenhuma informada';
    document.getElementById('resumo-perfil').innerHTML =
      '<p><strong>' + HA.escapar(perfil.nome || 'Sem nome') + '</strong>' + (idade(perfil.nascimento) ? ', ' + idade(perfil.nascimento) : '') + '</p>' +
      '<p>' + HA.escapar((HA.NOMES_TIPO[perfil.tipo] || '')) + '</p>' +
      '<p><strong>Necessidades:</strong> ' + HA.escapar(nec) + '</p>' +
      '<p><strong>Rotas evitam:</strong> ' + HA.escapar(evitar) + '</p>' +
      '<p><strong>Alertas por:</strong> ' + alertas + '</p>' +
      '<p><strong>Interface:</strong> ' + (itens.join(' · ') || 'padrão') + '</p>';
  }

  function aplicarPreset(tipo) {
    var pr = PRESETS[tipo]; if (!pr) return;
    Object.keys(pr.prefs).forEach(function (k) { HA.prefs[k] = pr.prefs[k]; });
    HA.aplicarPrefs();
    perfil.evitar = pr.evitar.slice();
    form.querySelectorAll('input[name="evitar"]').forEach(function (c) { c.checked = perfil.evitar.indexOf(c.value) > -1; });
    Object.keys(CAMPOS_PREFS).forEach(function (k) { document.getElementById(CAMPOS_PREFS[k]).checked = !!HA.prefs[k]; });
    document.getElementById('pf-escala').value = HA.prefs.escala;
    resumo();
    HA.anunciar('Recomendações aplicadas para o perfil ' + (HA.NOMES_TIPO[tipo] || '').replace('Perfil: ', '') + '. Toque em Salvar para manter.');
  }

  // Pré-visualização ao vivo
  form.addEventListener('change', function (e) {
    var t = e.target;
    if (t.name === 'tipo') { aplicarPreset(t.value); return; }
    Object.keys(CAMPOS_PREFS).forEach(function (k) { if (t.id === CAMPOS_PREFS[k]) { HA.prefs[k] = t.checked; HA.aplicarPrefs(); } });
    resumo();
  });
  form.addEventListener('input', function (e) {
    if (e.target.id === 'pf-escala') { HA.prefs.escala = +e.target.value; HA.aplicarPrefs(); }
    resumo();
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (!HA.validarFormulario(form)) return;
    lerFormulario();
    HA.perfil = JSON.parse(JSON.stringify(perfil));
    HA.salvarPerfil();
    HA.salvarPrefs();
    document.getElementById('msg-perfil').innerHTML = '<div class="aviso sucesso"><strong>Perfil salvo!</strong> As preferências já valem em todas as páginas.</div>';
    HA.anunciar('Perfil salvo.');
    window.scrollTo({ top: 0, behavior: HA.prefs.semAnimacao ? 'auto' : 'smooth' });
  });

  document.getElementById('btn-recomendado').addEventListener('click', function () {
    lerFormulario(); aplicarPreset(perfil.tipo);
  });
  document.getElementById('btn-exemplo').addEventListener('click', function () {
    perfil = JSON.parse(JSON.stringify(HA.PERFIL_PADRAO));
    preencher();
    aplicarPreset(perfil.tipo);
    HA.anunciar('Dados de exemplo restaurados. Toque em Salvar para manter.');
  });

  preencher();
});


