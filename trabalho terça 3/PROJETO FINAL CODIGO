        );

        // Camada Mapa Urbano Tradicional (Opcional)
        layerMapaRuas = L.tileLayer(
          'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
          {
            attribution: '&copy; OpenStreetMap contributors',
            maxZoom: 19
          }
        );

        // Inicia no modo Satélite Híbrido (Google Earth)
        layerSatelite.addTo(mapaInstancia);
        layerRotulos.addTo(mapaInstancia);

        camadaMarcadores = L.layerGroup().addTo(mapaInstancia);

