            <label class="opcao"><input type="checkbox" name="necessidades" value="cao-guia"> Ando com cão-guia</label>
            <label class="opcao"><input type="checkbox" name="necessidades" value="aparelho-auditivo"> Uso aparelho auditivo</label>
