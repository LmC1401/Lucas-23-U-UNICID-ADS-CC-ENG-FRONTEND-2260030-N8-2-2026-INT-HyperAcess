  HA.rascunho = function (form, chave) {
    var CHAVE = 'hyperacess-rascunho-' + chave;
    var status = document.createElement('p');
    status.className = 'status-rascunho';
    form.appendChild(status);

    function campos() {
      return Array.prototype.filter.call(form.elements, function (c) {
        return c.name && !c.disabled && c.type !== 'submit' && c.type !== 'button' && c.type !== 'password';
      });
    }
    function hora() {
      var d = new Date();
      return String(d.getHours()).padStart(2, '0') + 'h' + String(d.getMinutes()).padStart(2, '0');
    }
    function salvar() {
      var dados = {};
      campos().forEach(function (c) {
        if (c.type === 'radio') { if (c.checked) dados[c.name] = c.value; }
        else if (c.type === 'checkbox') { dados[c.name + '::' + c.value] = c.checked; }
        else dados[c.name] = c.value;
      });
      if (gravar(CHAVE, dados)) status.textContent = 'Rascunho salvo neste aparelho às ' + hora() + '.';
    }
    function restaurar() {
      var dados;
      try { dados = JSON.parse(localStorage.getItem(CHAVE) || 'null'); } catch (e) { dados = null; }
      if (!dados) return false;
      var algum = false;
      campos().forEach(function (c) {
        if (c.type === 'radio') { if (dados[c.name] !== undefined) { c.checked = dados[c.name] === c.value; algum = algum || c.checked; } }
        else if (c.type === 'checkbox') { var k = c.name + '::' + c.value; if (dados[k] !== undefined) c.checked = dados[k]; }
