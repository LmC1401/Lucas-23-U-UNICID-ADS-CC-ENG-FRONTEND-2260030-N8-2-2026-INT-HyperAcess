    }
    function gravar(chave, valor) {
      try { localStorage.setItem(chave, JSON.stringify(valor)); return true; } catch (e) { return false; }
    }
    function escapar(t) {
      return String(t).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; });
    }

    var timerToast;
    function anunciar(msg, urgente) {
      var r = $('regiao-viva');
      r.setAttribute('aria-live', urgente ? 'assertive' : 'polite');
      r.textContent = '';
      setTimeout(function () { r.textContent = msg; }, 50);
      var t = $('toast');
      t.textContent = msg; t.classList.add('visivel');
      clearTimeout(timerToast);
      timerToast = setTimeout(function () { t.classList.remove('visivel'); }, 3500);
    }

    var voz = window.speechSynthesis;
    function falarTexto(texto) {
      if (!voz) return;
      voz.cancel();
      var u = new SpeechSynthesisUtterance(texto);
      u.lang = 'pt-BR'; u.rate = 1;
      var pt = voz.getVoices().filter(function (v) { return /^pt/i.test(v.lang); })[0];
      if (pt) u.voice = pt;
      voz.speak(u);
    }
    function pararVoz() { if (voz) voz.cancel(); }

    var ctxAudio = null;
    function bipe(freq, dur, vezes) {
      try {
        ctxAudio = ctxAudio || new (window.AudioContext || window.webkitAudioContext)();
        if (ctxAudio.state === 'suspended') ctxAudio.resume();
        for (var i = 0; i < vezes; i++) {
          var t0 = ctxAudio.currentTime + i * (dur + 0.15);
          var o = ctxAudio.createOscillator(), g = ctxAudio.createGain();
          o.type = 'square'; o.frequency.value = freq;
          g.gain.setValueAtTime(0.0001, t0);
          g.gain.exponentialRampToValueAtTime(0.25, t0 + 0.02);
          g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
          o.connect(g).connect(ctxAudio.destination);
          o.start(t0); o.stop(t0 + dur + 0.05);
        }
      } catch (e) {}
    }

    function distancia(a, b) { // metros entre [lat,lng]
      var R = 6371000, r = Math.PI / 180;
      var dLat = (b[0] - a[0]) * r, dLng = (b[1] - a[1]) * r;
      var x = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(a[0] * r) * Math.cos(b[0] * r) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
      return 2 * R * Math.atan2(Math.sqrt(x), Math.sqrt(1 - x));
    }
    function distanciaLinha(p, linha) { // metros de um ponto até uma linha
      var kx = Math.cos(p[0] * Math.PI / 180) * 111320, ky = 110540, menor = Infinity;
      for (var i = 0; i < linha.length - 1; i++) {
        var ax = (linha[i][1] - p[1]) * kx, ay = (linha[i][0] - p[0]) * ky;
        var bx = (linha[i + 1][1] - p[1]) * kx, by = (linha[i + 1][0] - p[0]) * ky;
        var dx = bx - ax, dy = by - ay, l2 = dx * dx + dy * dy;
        var t = l2 ? Math.max(0, Math.min(1, -(ax * dx + ay * dy) / l2)) : 0;
        menor = Math.min(menor, Math.hypot(ax + t * dx, ay + t * dy));
      }
      return menor;
    }
    function formatarKm(m) { return m >= 1000 ? (m / 1000).toFixed(1).replace('.', ',') + ' km' : Math.round(m) + ' m'; }
    function agora() {
      var d = new Date(), p = function (n) { return String(n).padStart(2, '0'); };
