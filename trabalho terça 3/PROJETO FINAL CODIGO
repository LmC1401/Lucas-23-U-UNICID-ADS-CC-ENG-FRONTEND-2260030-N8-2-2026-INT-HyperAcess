  .iframe-mapa { height: 300px; }
  .mapa { height: 380px; }
  .form-container { padding: 1.25rem; }
  .form-linha { grid-template-columns: 1fr; }
  .filtros { gap: 0.75rem; }
  .filtros fieldset { width: 100%; }

  footer { padding: 1.5rem 1rem; margin-top: 2rem; font-size: 1rem; }
}

@media (max-width: 480px) {
  .btn-menu .rotulo-menu { display: none; }
  .hero h2, .hero h1.titulo-pagina { font-size: 1.5rem; }
  .btn-cta { display: block; width: 100%; padding: 1rem; }
  .grupo-botoes .btn { flex: 1 1 100%; }
  .iframe-mapa { height: 250px; }
