  function nomePonto(sel) {
    return sel.options[sel.selectedIndex].text.replace('📍 ', '');
  }

  /* Ponto deslocado perpendicularmente ao segmento (para gerar alternativas) */
  function desvio(a, b, metros) {
    var meio = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
    var kx = Math.cos(meio[0] * Math.PI / 180) * 111320, ky = 110540;
    var dx = (b[1] - a[1]) * kx, dy = (b[0] - a[0]) * ky, len = Math.sqrt(dx * dx + dy * dy) || 1;
    return [meio[0] + (dx / len) * metros / ky, meio[1] - (dy / len) * metros / kx];
  }

  async function osrm(pontos) {
    var coords = pontos.map(function (p) { return p[1].toFixed(6) + ',' + p[0].toFixed(6); }).join(';');
    var url = 'https://routing.openstreetmap.de/routed-foot/route/v1/foot/' + coords +
      '?overview=full&geometries=geojson&steps=true' + (pontos.length === 2 ? '&alternatives=true' : '');
    var ctrl = new AbortController(), t = setTimeout(function () { ctrl.abort(); }, 9000);
    try {
      var r = await fetch(url, { signal: ctrl.signal });
      if (!r.ok) throw new Error('HTTP ' + r.status);
      var j = await r.json();
      if (j.code !== 'Ok') throw new Error(j.code);
      return j.routes.map(function (rt) {
        var passos = [];
        rt.legs.forEach(function (leg) { leg.steps.forEach(function (s) { passos.push(s); }); });
        return { linha: rt.geometry.coordinates.map(function (c) { return [c[1], c[0]]; }), distancia: rt.distance, passos: passos, aproximada: false };
      });
    } finally { clearTimeout(t); }
  }

  function rotasAproximadas(a, b) {
    var direta = HA.distancia(a[0], a[1], b[0], b[1]);
    var lado = Math.max(250, Math.min(700, direta * 0.25));
    return [[a, b], [a, desvio(a, b, lado), b], [a, desvio(a, b, -lado), b]].map(function (linha) {
      // fator 1,3: ruas reais não são linhas retas
      return { linha: linha, distancia: HA.comprimentoLinha(linha) * 1.3, passos: [], aproximada: true };
    });
  }

  function textoPasso(s) {
    var rua = s.name ? (' na ' + s.name) : '';
    var lados = { left: 'à esquerda', right: 'à direita', 'slight left': 'levemente à esquerda', 'slight right': 'levemente à direita', 'sharp left': 'acentuadamente à esquerda', 'sharp right': 'acentuadamente à direita', uturn: 'fazendo o retorno', straight: 'em frente' };
    var m = s.maneuver || {}, dist = ' e siga por ' + HA.formatarDistancia(s.distance);
    if (m.type === 'depart') return 'Comece' + (s.name ? ' pela ' + s.name : '') + dist + '.';
    if (m.type === 'arrive') return 'Você chegou ao destino.';
    if (m.modifier && m.modifier !== 'straight') return 'Vire ' + (lados[m.modifier] || '') + rua + dist + '.';
    return 'Continue' + (s.name ? ' pela ' + s.name : ' em frente') + dist + '.';
  }

  function avaliar(rota, perfil, evitar) {
    var limite = rota.aproximada ? 70 : LIMITE_PROXIMIDADE;
    var problemas = D.ocorrencias.filter(function (o) {
      return HA.distanciaLinha(o.lat, o.lng, rota.linha) <= limite;
    });
    var pontos = 0;
    problemas.forEach(function (o) {
      var peso = D.severidades[o.sev].peso;
      if (evitar.indexOf(o.tipo) > -1) peso *= 3;
      if (o.afeta.indexOf(perfil) > -1) peso *= 1.5;
      pontos += peso;
    });
    rota.problemas = problemas;
    rota.pontos = pontos;
    return rota;
  }

  function selo(rota) {
    if (!rota.problemas.length) return '<span class="selo">Livre de problemas registrados</span>';
    var alta = rota.problemas.some(function (o) { return o.sev === 'alta'; });
    return '<span class="selo ' + (alta ? 'perigo' : 'atencao') + '">' + rota.problemas.length + (rota.problemas.length === 1 ? ' problema' : ' problemas') + '</span>';
  }

  function desenhar(rotas, indiceDestaque) {
    if (!mapa) return;
    camadaRotas.clearLayers();
    rotas.forEach(function (r, i) {
      if (i === indiceDestaque) return;
      L.polyline(r.linha, { color: '#6b7280', weight: 5, dashArray: '8 10', opacity: 0.9 }).addTo(camadaRotas)
        .bindTooltip('Alternativa ' + (i + 1));
    });
    var d = rotas[indiceDestaque];
    L.polyline(d.linha, { color: '#0b3d1c', weight: 10, opacity: 0.9 }).addTo(camadaRotas);
    var linha = L.polyline(d.linha, { color: '#22a447', weight: 6 }).addTo(camadaRotas);
    d.problemas.forEach(function (o) {
      L.marker([o.lat, o.lng], { icon: HA.iconeTipo(o.tipo), title: D.tipos[o.tipo].curto + ': ' + o.rua }).bindPopup(HA.popupOcorrencia(o)).addTo(camadaRotas);
    });
    mapa.fitBounds(linha.getBounds(), { padding: [30, 30] });
  }

  function render(rotas, perfil, evitar, nomes) {
    var melhor = rotas[0], vel = VELOCIDADE[perfil];
    function minutos(r) { return Math.max(1, Math.round(r.distancia / 1000 / vel * 60)); }
    var resumo;
    if (!melhor.problemas.length) {
      resumo = 'Rota recomendada de ' + nomes[0] + ' até ' + nomes[1] + ': ' + HA.formatarDistancia(melhor.distancia) + ', cerca de ' + minutos(melhor) + ' minutos. Nenhum problema registrado no caminho.';
    } else {
      resumo = 'Rota recomendada de ' + nomes[0] + ' até ' + nomes[1] + ': ' + HA.formatarDistancia(melhor.distancia) + ', cerca de ' + minutos(melhor) + ' minutos. Atenção: ' +
        melhor.problemas.map(function (o) { return D.tipos[o.tipo].curto.toLowerCase() + ' em ' + o.rua; }).join('; ') + '.';
    }
    var aviso = melhor.aproximada
      ? '<div class="aviso">O serviço de rotas está indisponível agora (sem internet?). Mostrando <strong>rotas aproximadas</strong> em linha reta com desvios; a análise de problemas continua válida como estimativa.</div>'
      : '';
    document.getElementById('resumo-rota').innerHTML = aviso + '<div class="aviso ' + (melhor.problemas.length ? '' : 'sucesso') + '"><strong>' + HA.escapar(resumo) + '</strong></div>';

    document.getElementById('lista-rotas').innerHTML = rotas.map(function (r, i) {
      var itens = r.problemas.length ? '<ul>' + r.problemas.map(function (o) {
        var t = D.tipos[o.tipo];
        return '<li><strong>' + t.curto + '</strong> (gravidade ' + D.severidades[o.sev].nome.toLowerCase() + ') — ' + HA.escapar(o.rua) + ': ' + HA.escapar(o.desc) +
          (evitar.indexOf(o.tipo) > -1 ? ' <em>(tipo que você pediu para evitar)</em>' : '') + '</li>';
      }).join('') + '</ul>' : '<p>Nenhum problema registrado a menos de ' + LIMITE_PROXIMIDADE + ' m deste caminho.</p>';
      var passos = r.passos.length ? '<details class="faq" style="margin-top:.75rem"><summary>Instruções passo a passo</summary><div class="resposta"><ol>' +
        r.passos.map(function (s) { return '<li>' + HA.escapar(textoPasso(s)) + '</li>'; }).join('') + '</ol></div></details>' : '';
      return '<article class="rota-opcao' + (i === 0 ? ' melhor' : '') + '">' +
        '<h3>' + (i === 0 ? 'Rota recomendada' : 'Alternativa ' + (i + 1)) + ' ' + selo(r) + '</h3>' +
        '<p><strong>Distância:</strong> ' + HA.formatarDistancia(r.distancia) + ' · <strong>Tempo estimado:</strong> ' + minutos(r) + ' min</p>' +
        itens + passos +
        '<div class="grupo-botoes">' +
          (mapa ? '<button type="button" class="btn btn-secundario" data-mostrar="' + i + '">Mostrar no mapa</button>' : '') +
          '<button type="button" class="btn" data-usar="' + i + '">Usar esta rota nos alertas GPS</button>' +
        '</div></article>';
    }).join('');

    desenhar(rotas, 0);
    if (HA.prefs.leitura || HA.perfil.tipo === 'visual') HA.falar(resumo);
  }

  document.getElementById('lista-rotas').addEventListener('click', function (e) {
    var b = e.target.closest('button');
    if (!b) return;
    if (b.hasAttribute('data-mostrar')) {
      desenhar(ultimasRotas, +b.getAttribute('data-mostrar'));
      document.getElementById('mapa-rota').scrollIntoView({ behavior: 'smooth', block: 'center' });
      HA.anunciar('Rota destacada no mapa.');
    }
    if (b.hasAttribute('data-usar')) {
      var r = ultimasRotas[+b.getAttribute('data-usar')];
      HA.gravar('hyperacess-rota', { nome: nomePonto(selO) + ' → ' + nomePonto(selD), linha: r.linha });
      window.location.href = 'alertas.html';
    }
  });

  document.getElementById('form-rota').addEventListener('submit', async function (e) {
    e.preventDefault();
    if (!HA.validarFormulario(this)) return;
    var botao = document.getElementById('btn-tracar');
    var perfil = document.getElementById('rt-perfil').value;
    var evitar = Array.from(document.querySelectorAll('input[name="evitar"]:checked')).map(function (i) { return i.value; });
    var a, b;
    try {
      a = await resolverPonto(selO, 'origem');
      b = await resolverPonto(selD, 'destino');
    } catch (err) {
      var msg = err && err.message && err.message.indexOf('Toque') === 0 ? err.message : 'Não foi possível obter sua localização. Verifique a permissão de GPS (veja a página de Ajuda).';
      document.getElementById('resumo-rota').innerHTML = '<div class="aviso erro">' + msg + '</div>';
      HA.anunciar(msg, true);
      return;
    }
    if (HA.distancia(a[0], a[1], b[0], b[1]) < 30) {
      document.getElementById('resumo-rota').innerHTML = '<div class="aviso erro">A partida e a chegada são o mesmo lugar. Escolha pontos diferentes.</div>';
      HA.anunciar('A partida e a chegada são o mesmo lugar.', true);
      return;
    }
    marcarPonto('origem', a); marcarPonto('destino', b);
    botao.disabled = true; botao.textContent = 'Calculando rotas...';
    document.getElementById('resumo-rota').innerHTML = '<p>Calculando rotas e verificando problemas nas vias...</p>';

    var candidatas = [];
    try {
      var direta = HA.distancia(a[0], a[1], b[0], b[1]);
      var lado = Math.max(200, Math.min(600, direta * 0.2));
      var resultados = await Promise.allSettled([osrm([a, b]), osrm([a, desvio(a, b, lado), b]), osrm([a, desvio(a, b, -lado), b])]);
      resultados.forEach(function (r) { if (r.status === 'fulfilled') candidatas = candidatas.concat(r.value); });
      if (!candidatas.length) throw new Error('sem rotas');
    } catch (err) {
      candidatas = rotasAproximadas(a, b);
    }

    candidatas.forEach(function (r) { avaliar(r, perfil, evitar); });
    // Remove rotas repetidas e desvios longos demais (mais de 60% maiores que a menor)
    var menor = Math.min.apply(null, candidatas.map(function (r) { return r.distancia; }));
    var unicas = [];
    candidatas.filter(function (r) { return r.distancia <= menor * 1.6; }).forEach(function (r) {
      var repetida = unicas.some(function (u) {
        return Math.abs(u.distancia - r.distancia) / u.distancia < 0.03 &&
          u.problemas.map(function (o) { return o.id; }).join() === r.problemas.map(function (o) { return o.id; }).join();
      });
      if (!repetida) unicas.push(r);
    });
    unicas.sort(function (x, y) { return x.pontos - y.pontos || x.distancia - y.distancia; });
    ultimasRotas = unicas.slice(0, 3);

    botao.disabled = false; botao.textContent = 'Traçar rota acessível';
    render(ultimasRotas, perfil, evitar, [nomePonto(selO), nomePonto(selD)]);
    HA.anunciar('Rotas calculadas. ' + ultimasRotas.length + ' opções encontradas.');
  });
});


===== ARQUIVO: js/alertas.js =====

/* Página 6 — Alertas por GPS (obstáculos fictícios)
   - "Simular percurso": anda automaticamente pela rota (rota salva no planejador ou rota de demonstração)
   - "Usar meu GPS real": usa a posição real do aparelho; se você estiver longe da rota,
     obstáculos fictícios são criados ao seu redor para demonstrar os alertas. */
document.addEventListener('DOMContentLoaded', function () {
  var D = window.HA_DADOS;

  var ROTA_DEMO = {
    nome: 'Av. Paulista — da Rua da Consolação até a Estação Paraíso (demonstração)',
    linha: [[-23.5555, -46.6625], [-23.5585, -46.6592], [-23.5614, -46.6559], [-23.5640, -46.6527], [-23.5665, -46.6498], [-23.5687, -46.6470], [-23.5712, -46.6442], [-23.5735, -46.6420]]
  };
  var MODELOS = [
    { nome: 'Obra com tapume ocupando a calçada', sev: 'alta',  dica: 'Desvie pela passagem sinalizada ao lado.' },
    { nome: 'Carro estacionado sobre a calçada',  sev: 'media', dica: 'Passagem estreita, siga devagar.' },
    { nome: 'Piso tátil interrompido',            sev: 'media', dica: 'Use a bengala com atenção: o piso guia termina aqui.' },
    { nome: 'Caçamba de entulho na calçada',      sev: 'media', dica: 'Desvio necessário pela lateral.' },
    { nome: 'Mesas de bar bloqueando a passagem', sev: 'baixa', dica: 'Peça passagem ou desvie pela esquerda.' },
    { nome: 'Calçada com poça d’água',            sev: 'baixa', dica: 'Piso escorregadio: reduza a velocidade.' }
  ];
  var TONS = { alta: [880, 0.18, 3], media: [660, 0.2, 2], baixa: [520, 0.25, 1] };

  var salva = HA.ler('hyperacess-rota', {});
  var rota = salva && salva.linha && salva.linha.length > 1 ? salva : ROTA_DEMO;
  var acumulado = [0];
  for (var i = 1; i < rota.linha.length; i++) {
    acumulado.push(acumulado[i - 1] + HA.distancia(rota.linha[i - 1][0], rota.linha[i - 1][1], rota.linha[i][0], rota.linha[i][1]));
  }
  var total = acumulado[acumulado.length - 1];

  var info = document.getElementById('info-rota');
  function mostrarInfoRota() {
    info.innerHTML = '<strong>Rota em uso:</strong> ' + HA.escapar(rota.nome) + ' (' + HA.formatarDistancia(total) + '). ' +
      (rota === ROTA_DEMO ? 'Para usar outra rota, trace-a no <a href="rotas.html">Planejador de Rotas</a> e toque em “Usar esta rota nos alertas GPS”.'
        : '<button type="button" class="btn btn-secundario" id="btn-rota-demo" style="margin-top:.5rem">Voltar para a rota de demonstração</button>');
    var b = document.getElementById('btn-rota-demo');
    if (b) b.addEventListener('click', function () { try { localStorage.removeItem('hyperacess-rota'); } catch (e) {} location.reload(); });
  }
  mostrarInfoRota();

  function pontoNaRota(s) {
    s = Math.max(0, Math.min(total, s));
    for (var i = 1; i < acumulado.length; i++) {
      if (s <= acumulado[i]) {
        var t = (s - acumulado[i - 1]) / ((acumulado[i] - acumulado[i - 1]) || 1);
        var a = rota.linha[i - 1], b = rota.linha[i];
        return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
      }
    }
    return rota.linha[rota.linha.length - 1];
  }

  /* Obstáculos: fictícios ao longo da rota + ocorrências reais próximas */
  var obstaculos = [];
  function obstaculosDaRota() {
    var lista = [0.18, 0.4, 0.62, 0.84].map(function (f, i) {
      var m = MODELOS[i % MODELOS.length], p = pontoNaRota(total * f);
      return { nome: m.nome, sev: m.sev, dica: m.dica, lat: p[0], lng: p[1], ficticio: true };
    });
    D.ocorrencias.forEach(function (o) {
      if (HA.distanciaLinha(o.lat, o.lng, rota.linha) <= 40) {
        lista.push({ nome: D.tipos[o.tipo].curto + ' — ' + o.rua, sev: o.sev, dica: o.desc, lat: o.lat, lng: o.lng, ficticio: false });
      }
    });
    return lista;
  }
  function obstaculosAoRedor(lat, lng) {
    return [80, 150, 220, 300, 380].map(function (dist, i) {
      var ang = (i * 72 + 20) * Math.PI / 180, m = MODELOS[i % MODELOS.length];
      return {
        nome: m.nome, sev: m.sev, dica: m.dica, ficticio: true,
        lat: lat + Math.cos(ang) * dist / 110540,
        lng: lng + Math.sin(ang) * dist / (111320 * Math.cos(lat * Math.PI / 180))
      };
    });
  }

  /* Mapa */
  var mapa = HA.criarMapa('mapa-alertas', rota.linha[0], 15);
  var camadaObst = mapa ? L.layerGroup().addTo(mapa) : null, marcadorUsuario = null, circuloPrecisao = null;
  if (mapa) {
    var pl = L.polyline(rota.linha, { color: '#004d99', weight: 6 }).addTo(mapa);
    mapa.fitBounds(pl.getBounds(), { padding: [30, 30] });
  }

  function definirObstaculos(lista) {
    obstaculos = lista;
    obstaculos.forEach(function (o) { o.avisado = false; o.avisoFinal = false; });
    var ol = document.getElementById('lista-obstaculos');
    ol.innerHTML = obstaculos.map(function (o) {
      return '<li><strong>' + HA.escapar(o.nome) + '</strong> — gravidade ' + D.severidades[o.sev].nome.toLowerCase() +
        (o.ficticio ? ' <em>(fictício)</em>' : ' <em>(registrado no mapa)</em>') + '</li>';
    }).join('');
    if (camadaObst) {
      camadaObst.clearLayers();
      obstaculos.forEach(function (o) {
        L.marker([o.lat, o.lng], { icon: HA.iconeClasse('obstaculo', '!', 26), title: o.nome }).bindPopup('<strong>' + HA.escapar(o.nome) + '</strong><br>' + HA.escapar(o.dica)).addTo(camadaObst);
      });
    }
  }
  definirObstaculos(obstaculosDaRota());

  /* Configurações (salvas no perfil) */
  var cfg = { som: 'cfg-som', voz: 'cfg-voz', vibracao: 'cfg-vibracao' };
  Object.keys(cfg).forEach(function (k) {
    var el = document.getElementById(cfg[k]);
    el.checked = !!HA.prefs[k];
    el.addEventListener('change', function () { HA.prefs[k] = el.checked; HA.salvarPrefs(); });
  });
  var selDist = document.getElementById('cfg-distancia');
  selDist.value = String(HA.prefs.distanciaAlerta || 80);
  if (!selDist.value) selDist.value = '80';
  selDist.addEventListener('change', function () { HA.prefs.distanciaAlerta = +selDist.value; HA.salvarPrefs(); });
  if (!('vibrate' in navigator)) {
    document.getElementById('cfg-vibracao').parentNode.insertAdjacentHTML('beforeend', ' <small>(não disponível neste aparelho)</small>');
  }
  if (HA.perfil.tipo === 'auditiva') {
    info.insertAdjacentHTML('beforeend', '<br><strong>Seu perfil:</strong> deficiência auditiva — os alertas visuais e a vibração ficam reforçados.');
  }

  /* Alertas */
  var painel = document.getElementById('painel'), log = document.getElementById('log-alertas'), primeiroLog = true;
  function registrar(texto) {
    if (primeiroLog) { log.innerHTML = ''; primeiroLog = false; }
    var agora = new Date();
    log.insertAdjacentHTML('afterbegin', '<li><strong>' + String(agora.getHours()).padStart(2, '0') + ':' + String(agora.getMinutes()).padStart(2, '0') + ':' + String(agora.getSeconds()).padStart(2, '0') + '</strong> — ' + HA.escapar(texto) + '</li>');
  }
  function alertar(o, dist, final) {
    var titulo = final ? '⚠ OBSTÁCULO LOGO À FRENTE' : '⚠ ATENÇÃO: obstáculo a ' + Math.round(dist) + ' m';
    var texto = o.nome + '. ' + o.dica;
    painel.className = 'painel-alerta';
    void painel.offsetWidth;
    painel.classList.add('ativo');
    document.getElementById('painel-titulo').textContent = titulo;
    document.getElementById('painel-texto').textContent = texto;
    document.body.classList.remove('flash-alerta'); void document.body.offsetWidth;
    document.body.classList.add('flash-alerta');
    setTimeout(function () { document.body.classList.remove('flash-alerta'); }, 3200);

    var falado = (final ? 'Atenção! Obstáculo logo à frente: ' : 'Atenção. Em ' + Math.round(dist) + ' metros: ') + texto;
    HA.anunciar(falado, true);
    if (HA.prefs.som) { var t = TONS[final ? 'alta' : o.sev]; HA.bipe(t[0], t[1], t[2]); }
    if (HA.prefs.voz) setTimeout(function () { HA.falar(falado); }, HA.prefs.som ? 900 : 0);
    if (HA.prefs.vibracao && navigator.vibrate) navigator.vibrate(final ? [500, 150, 500, 150, 500] : [300, 120, 300]);
    registrar((final ? 'Muito perto: ' : 'A ' + Math.round(dist) + ' m: ') + o.nome);
  }

  function verificar(lat, lng) {
    var limite = HA.prefs.distanciaAlerta || 80, proximo = null, menor = Infinity;
    obstaculos.forEach(function (o) {
      var d = HA.distancia(lat, lng, o.lat, o.lng);
      if (!o.avisoFinal && d < menor) { menor = d; proximo = o; }
      if (d <= limite && !o.avisado) { o.avisado = true; alertar(o, d, false); }
      else if (d <= 20 && !o.avisoFinal) { o.avisoFinal = true; o.avisado = true; alertar(o, d, true); }
    });
    document.getElementById('st-proximo').textContent = proximo ? proximo.nome + ' (' + HA.formatarDistancia(menor) + ')' : 'nenhum';
    if (proximo && menor > limite && !painel.classList.contains('ativo')) {
      painel.className = 'painel-alerta ok';
      document.getElementById('painel-titulo').textContent = '✓ Caminho livre';
      document.getElementById('painel-texto').textContent = 'Próximo obstáculo a ' + HA.formatarDistancia(menor) + '.';
    }
    if (painel.classList.contains('ativo') && (!proximo || menor > limite + 10)) painel.classList.remove('ativo');
  }

  function moverUsuario(lat, lng, precisao) {
    if (!mapa) return;
    if (!marcadorUsuario) {
      marcadorUsuario = L.marker([lat, lng], { icon: HA.iconeClasse('usuario', '', 22), title: 'Você está aqui', keyboard: false, zIndexOffset: 1000 }).addTo(mapa);
    } else marcadorUsuario.setLatLng([lat, lng]);
    if (precisao) {
      if (!circuloPrecisao) circuloPrecisao = L.circle([lat, lng], { radius: precisao, color: '#004d99', weight: 1, fillOpacity: 0.1 }).addTo(mapa);
      else circuloPrecisao.setLatLng([lat, lng]).setRadius(precisao);
    }
    if (!mapa.getBounds().pad(-0.2).contains([lat, lng])) mapa.panTo([lat, lng]);
  }

  /* Controles */
  var timer = null, watchId = null, s = 0, wakeLock = null;
  var bSim = document.getElementById('btn-simular'), bGps = document.getElementById('btn-gps'), bParar = document.getElementById('btn-parar');

  async function manterTelaLigada() {
    try { if ('wakeLock' in navigator) wakeLock = await navigator.wakeLock.request('screen'); } catch (e) {}
  }
  function emAndamento(modo) {
    document.getElementById('st-modo').textContent = modo;
    bSim.disabled = bGps.disabled = true; bParar.disabled = false;
    painel.className = 'painel-alerta ok';
    document.getElementById('painel-titulo').textContent = '✓ Alertas ligados';
    document.getElementById('painel-texto').textContent = 'Acompanhando seu trajeto...';
    HA.prepararAudio();
    manterTelaLigada();
    bParar.focus();
  }
  function parar(msg) {
    clearInterval(timer); timer = null;
    if (watchId !== null && navigator.geolocation) navigator.geolocation.clearWatch(watchId);
    watchId = null;
    if (wakeLock) { try { wakeLock.release(); } catch (e) {} wakeLock = null; }
    bSim.disabled = bGps.disabled = false; bParar.disabled = true;
    document.getElementById('st-modo').textContent = 'parado';
    painel.className = 'painel-alerta';
    document.getElementById('painel-titulo').textContent = msg || 'Alertas desligados';
    document.getElementById('painel-texto').textContent = 'Toque em “Simular percurso” ou “Usar meu GPS” para começar.';
    if (window.speechSynthesis) window.speechSynthesis.cancel();
  }

  bSim.addEventListener('click', function () {
    definirObstaculos(obstaculosDaRota());
    s = 0;
    emAndamento('simulação');
    registrar('Simulação iniciada.');
    HA.anunciar('Simulação iniciada.');
    timer = setInterval(function () {
      var mult = +document.getElementById('cfg-velocidade').value;
      s += 1.2 * mult * 0.5; // 1,2 m/s ≈ caminhada lenta
      var p = pontoNaRota(s);
      moverUsuario(p[0], p[1]);
      document.getElementById('st-progresso').textContent = HA.formatarDistancia(Math.min(s, total)) + ' de ' + HA.formatarDistancia(total);
      verificar(p[0], p[1]);
      if (s >= total) {
        parar('✓ Você chegou ao destino');
        registrar('Chegada ao destino.');
        HA.anunciar('Você chegou ao destino.', true);
        if (HA.prefs.voz) HA.falar('Você chegou ao destino.');
        if (HA.prefs.som) HA.bipe(520, 0.15, 2);
      }
    }, 500);
  });

  bGps.addEventListener('click', function () {
    if (!navigator.geolocation) { HA.anunciar('Este aparelho não oferece GPS no navegador.', true); return; }
    emAndamento('GPS real (aguardando sinal...)');
    var primeiro = true;
    watchId = navigator.geolocation.watchPosition(function (pos) {
      var lat = pos.coords.latitude, lng = pos.coords.longitude;
      document.getElementById('st-modo').textContent = 'GPS real';
      document.getElementById('st-precisao').textContent = Math.round(pos.coords.accuracy) + ' m';
      if (primeiro) {
        primeiro = false;
        if (HA.distanciaLinha(lat, lng, rota.linha) > 300) {
          definirObstaculos(obstaculosAoRedor(lat, lng));
          registrar('Você está longe da rota: obstáculos fictícios foram criados ao seu redor para demonstração.');
          HA.anunciar('Obstáculos de demonstração criados ao seu redor.');
          if (mapa) mapa.setView([lat, lng], 16);
        } else {
          definirObstaculos(obstaculosDaRota());
        }
