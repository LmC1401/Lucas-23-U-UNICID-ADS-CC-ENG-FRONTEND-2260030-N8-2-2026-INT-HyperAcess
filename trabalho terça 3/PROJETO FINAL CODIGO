  .tabela-responsiva thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
  .tabela-responsiva tr { display: block; border-bottom: 3px solid var(--border-color); padding: 0.5rem 0; }
  .tabela-responsiva td { display: block; border: none; padding: 0.3rem 0.7rem; }
  .tabela-responsiva td::before { content: attr(data-rotulo) ": "; font-weight: bold; }
}

/* Respeita usuários sensíveis a movimento */
@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; animation: none !important; }
}

