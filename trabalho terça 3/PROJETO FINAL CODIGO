  color: #fff;
  font-weight: bold;
  font-size: 14px;
  border: 3px solid #fff;
  box-shadow: 0 0 0 2px #1a1a1a, 0 2px 6px rgba(0,0,0,0.4);
}
.marcador.apoio { background: #146c2e; border-radius: 6px; }
.marcador.usuario { background: #004d99; width: 22px; height: 22px; }
.marcador.obstaculo { background: #b3261e; border-radius: 4px; }
.marcador.pino { background: #000; }

.legenda {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  list-style: none;
  font-size: 0.95rem;
  margin-top: 0.75rem;
}
.legenda li { display: flex; align-items: center; gap: 0.4rem; }
.legenda .marcador { width: 24px; height: 24px; font-size: 12px; border-width: 2px; }

/* Filtros */
.filtros {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 2rem;
  margin-top: 1rem;
}
.filtros fieldset {
  border: 2px solid var(--border-color);
  border-radius: 8px;
  padding: 0.6rem 1rem 0.8rem;
  min-width: 0;
}
.filtros legend { font-weight: bold; padding: 0 0.3rem; }
.opcao {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 40px;
  cursor: pointer;
}
.opcao input[type="checkbox"], .opcao input[type="radio"] {
  width: 22px;
  height: 22px;
  flex: none;
  accent-color: var(--primary-color);
}

.lista-limpa { list-style: none; }

/* ==========================================================================
   6. FORMULÁRIOS
   ========================================================================== */
.form-container {
  background-color: var(--bg-surface);
  border: 2px solid var(--border-color);
  padding: 2rem;
  border-radius: 8px;
}

.campo-form { margin-bottom: 1.2rem; }

.campo-form label, .campo-form .rotulo {
  display: block;
  font-weight: bold;
  margin-bottom: 0.4rem;
}

.campo-form input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
.campo-form select,
.campo-form textarea {
  width: 100%;
  max-width: 100%;
  padding: 0.8rem;
  font-size: 1rem;
  border: 2px solid #555;
  border-radius: 4px;
  background-color: var(--bg-color);
  color: var(--text-color);
  min-height: 48px;
}
.campo-form select { text-overflow: ellipsis; }
.campo-form input[type="range"] { width: 100%; accent-color: var(--primary-color); min-height: 40px; }
.campo-form .dica { font-size: 0.95rem; color: var(--text-muted); margin-top: 0.3rem; }
.campo-form .erro-campo { color: var(--perigo); font-weight: bold; font-size: 0.95rem; margin-top: 0.3rem; }
.campo-form [aria-invalid="true"] { border-color: var(--perigo) !important; border-width: 3px !important; }

.form-linha {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 1rem;
}
.form-linha > * { min-width: 0; }

.btn-submit {
  width: 100%;
  background-color: var(--primary-color);
  color: #ffffff;
  padding: 1rem;
  font-size: 1.1rem;
  font-weight: bold;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  min-height: 48px;
}
.btn-submit:hover { background-color: var(--primary-hover); }

/* Seleção de estrelas acessível (radio) */
.estrelas { display: flex; gap: 0.4rem; flex-wrap: wrap; border: none; }
.estrelas input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.estrelas label {
  display: grid;
  place-items: center;
  min-width: 48px;
  min-height: 48px;
  border: 2px solid var(--border-color);
  border-radius: 8px;
  font-size: 1.1rem;
  cursor: pointer;
  margin: 0;
  background: var(--bg-color);
}
.estrelas input:checked + label { background: var(--primary-color); color: #fff; border-color: var(--primary-color); }
.estrelas input:focus + label { outline: 4px solid var(--focus-outline); outline-offset: 2px; }

/* Cartões de seleção de perfil */
.perfis {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 0.75rem;
  border: none;
}
.perfis legend { font-weight: bold; margin-bottom: 0.5rem; }
.perfil-opcao { position: relative; }
.perfil-opcao input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.perfil-opcao label {
  display: block;
  height: 100%;
  border: 3px solid var(--border-color);
  border-radius: 10px;
  padding: 0.9rem;
  background: var(--bg-color);
  cursor: pointer;
  font-weight: normal;
  margin: 0;
}
.perfil-opcao label strong { display: block; font-size: 1.05rem; }
.perfil-opcao label span { font-size: 0.95rem; color: var(--text-muted); }
.perfil-opcao input:checked + label { border-color: var(--primary-color); box-shadow: inset 0 0 0 3px var(--primary-color); background: var(--bg-surface); }
.perfil-opcao input:checked + label strong::before { content: "✓ "; }
.perfil-opcao input:focus + label { outline: 4px solid var(--focus-outline); outline-offset: 2px; }

/* ==========================================================================
   7. TABELAS, FAQ, ROTAS E ALERTAS
   ========================================================================== */
.tabela-wrap { overflow-x: auto; border: 2px solid var(--border-color); border-radius: 8px; }
table { width: 100%; border-collapse: collapse; font-size: 1rem; }
th, td { padding: 0.7rem; text-align: left; border-bottom: 1px solid #c4c9cf; vertical-align: top; }
th { background: var(--bg-surface); }

details.faq {
  border: 2px solid var(--border-color);
  border-radius: 8px;
  margin-bottom: 0.75rem;
  background: var(--bg-surface);
}
details.faq summary {
  cursor: pointer;
  font-weight: bold;
  padding: 1rem;
  min-height: 48px;
  list-style-position: inside;
}
details.faq[open] summary { border-bottom: 2px solid var(--border-color); }
details.faq .resposta { padding: 1rem; }
details.faq .resposta ol, details.faq .resposta ul { padding-left: 1.5rem; margin-top: 0.5rem; }

.resultado-rota { margin-top: 1rem; }
.rota-opcao {
  border: 3px solid var(--border-color);
  border-radius: 8px;
  padding: 1rem;
  margin-bottom: 0.75rem;
  background: var(--bg-surface);
}
.rota-opcao.melhor { border-color: var(--sucesso); border-left-width: 12px; }
.rota-opcao h3 { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
.selo {
  font-size: 0.85rem;
  padding: 0.15rem 0.6rem;
  border-radius: 999px;
  background: var(--sucesso);
  color: #fff;
}
.selo.atencao { background: var(--cor-recape); }
.selo.perigo { background: var(--perigo); }
.rota-opcao ul { padding-left: 1.25rem; margin-top: 0.4rem; }

.painel-alerta {
  border: 4px solid var(--border-color);
  border-radius: 12px;
  padding: 1.25rem;
  margin: 1rem 0;
  background: var(--bg-surface);
  text-align: center;
}
.painel-alerta .alerta-titulo { font-size: 1.5rem; font-weight: bold; }
.painel-alerta.ativo {
  background: #b3261e;
  color: #fff;
  border-color: #000;
  animation: piscar 0.8s steps(2, start) 6;
}
.painel-alerta.ok { border-color: var(--sucesso); }
@keyframes piscar { to { background: #000; } }

body.flash-alerta::after {
  content: "";
  position: fixed;
  inset: 0;
  border: 12px solid #b3261e;
  pointer-events: none;
  z-index: 2000;
  animation: piscar-borda 0.6s steps(2, start) 5;
}
@keyframes piscar-borda { to { border-color: #ffbf47; } }

.log-alertas { max-height: 260px; overflow-y: auto; }
.log-alertas li { padding: 0.5rem 0; border-bottom: 1px solid #c4c9cf; font-size: 1rem; }

.status-gps {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  font-size: 1rem;
  margin-top: 0.5rem;
}

/* Toast / mensagens anunciadas */
.toast {
  position: fixed;
  left: 50%;
  bottom: 1.25rem;
  transform: translateX(-50%);
  background: #1a1a1a;
  color: #fff;
  padding: 0.9rem 1.25rem;
  border-radius: 8px;
  border: 2px solid #ffbf47;
  z-index: 3000;
  max-width: calc(100% - 2rem);
  font-weight: bold;
  display: none;
}
.toast.visivel { display: block; }

/* ==========================================================================
   8. RODAPÉ
   ========================================================================== */
footer {
  background-color: #1a1a1a;
  color: #ffffff;
  text-align: center;
  padding: 2rem;
  margin-top: 3rem;
}
footer a { color: #ffbf47; }
footer p + p { margin-top: 0.5rem; font-size: 0.95rem; }

/* ==========================================================================
   9. PERSONALIZAÇÕES DO PERFIL / ACESSIBILIDADE
   ========================================================================== */
/* Alto contraste (WCAG AAA) */
html.alto-contraste {
  --bg-color: #000000;
  --bg-surface: #000000;
  --text-color: #ffffff;
  --text-muted: #ffffff;
  --primary-color: #000000;
  --primary-hover: #222222;
  --link-color: #ffff00;
  --border-color: #ffffff;
  --sucesso: #7CFC00;
  --perigo: #ff6b6b;
}
html.alto-contraste header.header-principal { border-bottom: 3px solid #ffff00; }
