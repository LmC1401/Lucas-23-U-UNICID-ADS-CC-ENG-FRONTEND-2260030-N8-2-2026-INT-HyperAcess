/* ==========================================================================
   1. VARIÁVEIS E CONFIGURAÇÕES GERAIS (WCAG Nível AAA)
   ========================================================================== */
:root {
  --bg-color: #ffffff;
  --bg-surface: #f4f6f8;
  --text-color: #1a1a1a;
  --text-muted: #4a4f55;
  --primary-color: #004d99;
  --primary-hover: #003366;
  --link-color: #004d99;
  --border-color: #1a1a1a;
  --focus-outline: #ffbf47; /* Amarelo alto contraste para foco */
  --sucesso: #146c2e;
  --perigo: #b3261e;

  /* Alertas de Ocorrência */
  --cor-buraco: #c62828;         /* Vermelho */
  --cor-alagamento: #0263b8;     /* Azul */
  --cor-recape: #b45309;         /* Laranja Escuro */
  --cor-acessibilidade: #7e22ce; /* Roxo/Lilás Alto Contraste */
  --cor-sinalizacao: #0f766e;    /* Verde-azulado */

  --font-family: Arial, Helvetica, sans-serif;
  --font-base: 1.125rem; /* ~18px para facilitar a leitura */
  --line-height: 1.6;
  --escala-fonte: 1;     /* Controlada pelos botões A+ / A- e pelo perfil */
  --espaco-letras: normal;
}

html {
  font-size: calc(100% * var(--escala-fonte));
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg-color);
  color: var(--text-color);
  font-family: var(--font-family);
  font-size: var(--font-base);
  line-height: var(--line-height);
  letter-spacing: var(--espaco-letras);
}

body.gaveta-aberta {
  overflow: hidden; /* Trava a rolagem da página com a gaveta aberta */
}

img, iframe, video { max-width: 100%; }

h1, h2, h3, h4, p, a, li, td { overflow-wrap: break-word; }

a { color: var(--link-color); }

button, input, select, textarea { font-family: inherit; }

/* Utilitário para Leitores de Tela (NVDA / TalkBack) */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Foco Visível Teclado (Mobilidade / Deficiência Visual) */
a:focus, button:focus, input:focus, select:focus, textarea:focus, iframe:focus,
summary:focus, [tabindex]:focus {
  outline: 4px solid var(--focus-outline) !important;
  outline-offset: 3px;
}

/* Atalho de Teclado */
.link-atalho {
  position: absolute;
  top: 0;
  left: 10px;
  transform: translateY(-200%);
  background: var(--focus-outline);
  color: #000;
  padding: 8px 16px;
  font-weight: bold;
  z-index: 9999;
  transition: transform 0.2s;
}
.link-atalho:focus { transform: translateY(10px); }

/* ==========================================================================
