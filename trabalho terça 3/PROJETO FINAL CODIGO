      camadaMarcadores.clearLayers();
      const catFiltro = document.getElementById('filtro-categoria').value;
      const regFiltro = document.getElementById('filtro-regiao').value;

      ocorrenciasIniciais.concat(marcacoesUsuario)
        .filter(item => (catFiltro === 'todos' || item.cat === catFiltro) && (regFiltro === 'todas' || item.regiao === regFiltro))
        .forEach(item => {
          const info = configPinos[item.cat] || configPinos.buraco;
          const icone = L.divIcon({
            className: 'custom-pin',
            html: `<div style="background:${getComputedStyle(htmlEl).getPropertyValue('--cor-' + item.cat).trim() || info.cor};color:#fff;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;font-weight:800;border:3px solid #fff;box-shadow:0 3px 10px rgba(0,0,0,0.65);">${info.letra}</div>`,
            iconSize: [32, 32]
          });
          L.marker([item.lat, item.lng], { icon: icone })
            .bindPopup(`<strong>${item.titulo}</strong><br>Região: ${item.regiao}<br>Status: ${item.status}`)
            .on('click', () => { if (iaVozAtiva) falarRespostaIA(`${item.titulo}. Região: ${item.regiao}. Status: ${item.status}.`); })
            .addTo(camadaMarcadores);
        });
    }

    document.getElementById('filtro-categoria').addEventListener('change', renderizarMarcadores);
    document.getElementById('filtro-regiao').addEventListener('change', () => {
      renderizarMarcadores();
      // Leva a visão de satélite direto para a região escolhida
      if (!mapaInstancia) return;
      const btnHibrido = document.querySelector('.btn-camada[data-camada="hibrido"]');
      if (mapaInstancia.hasLayer(layerMapaRuas) && btnHibrido) btnHibrido.click();
      const alvo = centrosRegioes[document.getElementById('filtro-regiao').value] || centrosRegioes.todas;
      mapaInstancia.flyTo(alvo.c, alvo.z, { duration: 1.4 });
    });
    document.getElementById('btn-centralizar-sp').addEventListener('click', () => {
      if (mapaInstancia) mapaInstancia.flyTo([-23.58, -46.60], 11, { duration: 1.4 });
    });
    document.getElementById('btn-voar-paulista').addEventListener('click', () => {
      if (mapaInstancia) mapaInstancia.flyTo([-23.5614, -46.6559], 17, { duration: 1.5 });
    });

    /* ==========================================================================
       5. CHAMADOS & LOCALSTORAGE (PÁGINA 4)
       ========================================================================== */
    const formChamado = document.getElementById('form-chamado');
    const tbodyChamados = document.getElementById('lista-chamados-tbody');
    let chamadosSalvos = JSON.parse(localStorage.getItem('ha_chamados')) || [
      { protocolo: 'HA-2026-019', categoria: 'Falta de Rampa', regiao: 'Centro SP — Av. Paulista', status: 'Aberto' },
      { protocolo: 'HA-2026-020', categoria: 'Buraco na Calçada', regiao: 'Zona Leste — Tatuapé', status: 'Em análise' },
      { protocolo: 'HA-2026-021', categoria: 'Piso Tátil', regiao: 'Santo André — Centro', status: 'Aberto' }
    ];

    function atualizarTabelaChamados() {
      tbodyChamados.innerHTML = chamadosSalvos.map(c => `
        <tr>
          <td><strong>${c.protocolo}</strong></td>
          <td>${c.categoria}</td>
          <td>${c.regiao}</td>
          <td>${c.status}</td>
        </tr>
      `).join('');
      document.getElementById('contador-ocorrencias').textContent = 18 + chamadosSalvos.length;
    }
    atualizarTabelaChamados();

    ['chamado-nome', 'chamado-endereco', 'chamado-descricao'].forEach(id => {
      const el = document.getElementById(id);
      const salvo = localStorage.getItem('rascunho_' + id);
      if (salvo) el.value = salvo;
      el.addEventListener('input', () => localStorage.setItem('rascunho_' + id, el.value));
    });

    document.getElementById('btn-limpar-rascunho').addEventListener('click', () => {
      formChamado.reset();
      ['chamado-nome', 'chamado-endereco', 'chamado-descricao'].forEach(id => localStorage.removeItem('rascunho_' + id));
    });

    formChamado.addEventListener('submit', (e) => {
      e.preventDefault();
      const nome = document.getElementById('chamado-nome').value.trim();
      const cat = document.getElementById('chamado-categoria').value;
      const reg = document.getElementById('chamado-regiao').value;
      const end = document.getElementById('chamado-endereco').value.trim();
      const desc = document.getElementById('chamado-descricao').value.trim();

      document.getElementById('erro-nome').textContent = nome ? '' : 'Informe seu nome.';
      document.getElementById('erro-categoria').textContent = cat ? '' : 'Selecione o tipo de barreira.';
      document.getElementById('erro-regiao').textContent = reg ? '' : 'Selecione a região.';
      document.getElementById('erro-endereco').textContent = end ? '' : 'Informe o endereço ou referência.';
      document.getElementById('erro-descricao').textContent = desc ? '' : 'Descreva o problema.';

      if (!nome || !cat || !reg || !end || !desc) return;

      const protocolo = 'HA-2026-' + Math.floor(100 + Math.random() * 900);
      chamadosSalvos.unshift({
        protocolo,
        categoria: cat.toUpperCase(),
        regiao: `${reg} — ${end}`,
        status: 'Registrado'
      });
      localStorage.setItem('ha_chamados', JSON.stringify(chamadosSalvos));
      atualizarTabelaChamados();
      formChamado.reset();
      ['chamado-nome', 'chamado-endereco', 'chamado-descricao'].forEach(id => localStorage.removeItem('rascunho_' + id));
      document.getElementById('retorno-chamado').textContent = `✅ Chamado registrado com sucesso! Protocolo: ${protocolo}`;
    });

    /* ==========================================================================
       6. ALERTAS GPS & SIMULADOR (PÁGINA 6)
       ========================================================================== */
    function tocarBipeAlerta() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, ctx.currentTime);
        gain.gain.setValueAtTime(0.25, ctx.currentTime);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.35);
      } catch (err) {}
    }

    document.getElementById('btn-simular-alerta').addEventListener('click', () => {
      const dist = document.getElementById('distancia-alerta').value;
      const msg = `⚠️ ALERTA HYPERACESS (${dist}m): Calçada danificada e ausência de rampa à frente! Desvie à direita pelo piso tátil.`;
      document.getElementById('painel-alerta-visual').textContent = msg;

      if (document.getElementById('chk-bipe').checked) tocarBipeAlerta();
      if (document.getElementById('chk-vibrar').checked && 'vibrate' in navigator) {
        navigator.vibrate([250, 100, 250]);
      }
      if (document.getElementById('chk-voz').checked && 'speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(msg);
        u.lang = 'pt-BR';
        window.speechSynthesis.speak(u);
      }
    });

    document.getElementById('btn-usar-gps').addEventListener('click', () => {
      const painel = document.getElementById('painel-alerta-visual');
      if (!('geolocation' in navigator)) {
        painel.textContent = 'Geolocalização não suportada neste navegador.';
        return;
      }
      painel.textContent = '📡 Obtendo coordenadas GPS em tempo real...';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          painel.textContent = `✅ GPS Ativo! Latitude: ${pos.coords.latitude.toFixed(4)}, Longitude: ${pos.coords.longitude.toFixed(4)}. Monitorando barreiras próximas.`;
        },
        () => {
          painel.textContent = '⚠️ Permissão de GPS negada ou indisponível. Use o botão "Simular Percurso e Alerta" para testar.';
        }
      );
    });

    /* ==========================================================================
       7. PERFIL (PÁGINA 7) & CONTATO (PÁGINA 10)
       ========================================================================== */
    document.getElementById('btn-salvar-perfil').addEventListener('click', () => {
      const nec = document.getElementById('perfil-necessidade').value;
      const bairro = document.getElementById('perfil-bairro').value;
      localStorage.setItem('ha_perfil', JSON.stringify({ nec, bairro }));
      document.getElementById('status-perfil').textContent = '✅ Preferências de perfil salvas com sucesso!';
    });

    document.getElementById('form-contato').addEventListener('submit', (e) => {
      e.preventDefault();
      const nome = document.getElementById('contato-nome').value.trim();
      const email = document.getElementById('contato-email').value.trim();
      const msg = document.getElementById('contato-mensagem').value.trim();

      document.getElementById('erro-contato-nome').textContent = nome ? '' : 'Preencha seu nome.';
      const emailValido = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);
      document.getElementById('erro-contato-email').textContent = emailValido ? '' : 'Informe um e-mail válido (ex.: nome@gmail.com). A resposta será enviada para ele.';
      document.getElementById('erro-contato-msg').textContent = msg ? '' : 'Escreva uma mensagem.';

      if (!nome || !emailValido || !msg) return;

      // Envio real: o FormSubmit entrega a mensagem em 686769testes1@gmail.com
      // e manda uma cópia de confirmação para o e-mail do usuário (_autoresponse)
      if (location.protocol === 'file:') {
        document.getElementById('retorno-contato').textContent = '⚠️ Para enviar o e-mail, abra o site pelo link publicado (GitHub Pages). Aberto direto do computador, o envio não funciona.';
        return;
      }
      const enderecoPagina = location.href.split('#')[0].split('?')[0];
      document.getElementById('contato-next').value = enderecoPagina + '?enviado=1';
      document.getElementById('contato-url').value = enderecoPagina;
      const assunto = document.getElementById('contato-assunto');
      document.getElementById('contato-assunto-texto').value = assunto.options[assunto.selectedIndex].text;
      const btnEnviar = document.getElementById('btn-enviar-contato');
      btnEnviar.disabled = true;
      btnEnviar.textContent = '⏳ Enviando...';
      document.getElementById('retorno-contato').textContent = 'Enviando sua mensagem...';
      e.target.submit();
    });

    /* ==========================================================================
       8. ASSISTENTE VIRTUAL IA — TOGGLE START/STOP DA FALA AO CLICAR NOVAMENTE
       ========================================================================== */
    const btnAbrirChat = document.getElementById('btn-abrir-chat');
    const btnFecharChat = document.getElementById('btn-fechar-chat');
    const janelaChat = document.getElementById('janela-chat');
    const formChat = document.getElementById('form-chat');
    const inputChat = document.getElementById('input-chat');
    const chatMensagens = document.getElementById('chat-mensagens');
    const btnIaVozToggle = document.getElementById('btn-ia-voz-toggle');

    let iaVozAtiva = false;
    let ultimaRespostaTextoLimpo = 'Olá! Sou a IA do HyperAcess. Respondo qualquer dúvida sobre o site.';

    function pararFalaIA() {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
    }

    function atualizarBotaoVozIA() {
      btnIaVozToggle.setAttribute('aria-pressed', String(iaVozAtiva));
      btnIaVozToggle.textContent = iaVozAtiva ? '🔊 Narração IA: Ligada' : '🔇 Narração IA: Desligada';
    }

    function falarRespostaIA(textoLimpo) {
      if (!('speechSynthesis' in window)) return;
      window.speechSynthesis.cancel();

      const fala = new SpeechSynthesisUtterance(textoLimpo);
      fala.lang = 'pt-BR';
      window.speechSynthesis.speak(fala);
    }

    // Um único botão: 1º clique liga a narração, 2º clique desliga (e para a fala na hora)
    btnIaVozToggle.addEventListener('click', () => {
      iaVozAtiva = !iaVozAtiva;
      atualizarBotaoVozIA();
      if (iaVozAtiva) {
        falarRespostaIA(ultimaRespostaTextoLimpo);
      } else {
        pararFalaIA();
      }
    });

    function abrirChat() {
      janelaChat.classList.add('aberto');
      janelaChat.setAttribute('aria-hidden', 'false');
      btnAbrirChat.setAttribute('aria-expanded', 'true');
      inputChat.focus();
    }

    function fecharChat() {
      janelaChat.classList.remove('aberto');
      janelaChat.setAttribute('aria-hidden', 'true');
      btnAbrirChat.setAttribute('aria-expanded', 'false');
      pararFalaIA();
    }

    // Clicar no botão do Assistente IA pela 1ª vez abre; clicar pela 2ª vez fecha e para a fala
    btnAbrirChat.addEventListener('click', () => {
      if (janelaChat.classList.contains('aberto')) {
        fecharChat();
      } else {
        abrirChat();
      }
    });
    btnFecharChat.addEventListener('click', fecharChat);

    const conhecimentoSite = [
      {
        chaves: ['o que e', 'sobre', 'hyperacess', 'site', 'projeto', 'funciona', 'objetivo', 'serve'],
        resposta: 'O <strong>HyperAcess</strong> é uma plataforma web colaborativa de mapeamento urbano inclusivo para São Paulo e Grande ABC. Ele ajuda pessoas com deficiência visual, auditiva, motora e idosos a encontrar rotas acessíveis, visualizar barreiras no mapa satélite e receber alertas por voz, som e vibração.'
      },
      {
        chaves: ['pagina', 'paginas', 'menu', 'secao', 'secoes', 'navegar', 'estrutura'],
        resposta: 'O site possui 10 páginas integradas: <strong>1. Início</strong>, <strong>2. Quem Somos</strong>, <strong>3. Mapa Satélite</strong>, <strong>4. Chamados</strong>, <strong>5. Rotas Acessíveis</strong>, <strong>6. Alertas GPS</strong>, <strong>7. Perfil</strong>, <strong>8. Painel Prefeituras</strong>, <strong>9. Ajuda & Vídeo</strong> e <strong>10. Fale Conosco</strong>.'
      },
      {
        chaves: ['acessibilidade', 'fonte', 'letra', 'contraste', 'daltonismo', 'escuro', 'voz', 'wcag', 'leitor'],
        resposta: 'Na barra superior do site você pode aumentar ou diminuir a fonte (A+ e A-), ativar o <strong>Alto Contraste</strong>, ligar o <strong>Modo Escuro</strong>, usar a paleta para <strong>Daltonismo (Okabe-Ito)</strong> e clicar em <strong>Ouvir Página</strong>.'
      },
      {
        chaves: ['mapa', 'satelite', 'google earth', 'earth', 'risco', 'riscos', 'marcador', 'pino', 'filtro', 'regiao', 'sao paulo', 'abc'],
        resposta: 'Na <strong>Página 3 (Mapa Satélite)</strong> você tem visualização aérea estilo Google Earth com satélite híbrido, satélite puro e mapa urbano, mostrando marcadores por cor e letra: <strong>B</strong> (Buraco), <strong>R</strong> (Falta de Rampa), <strong>P</strong> (Piso Tátil), <strong>S</strong> (Semáforo Sonoro) e <strong>O</strong> (Obra).'
      },
      {
        chaves: ['chamado', 'chamados', 'relatar', 'denuncia', 'reportar', 'protocolo', 'rascunho', 'buraco', 'rampa'],
        resposta: 'Na <strong>Página 4 (Chamados)</strong> você registra obstáculos em menos de 1 minuto. O formulário salva rascunhos automaticamente no <code>localStorage</code> e gera um número de protocolo imediato.'
      },
      {
        chaves: ['rota', 'rotas', 'caminho', 'trajeto', 'cadeirante', 'comparar'],
        resposta: 'Na <strong>Página 5 (Rotas)</strong> o sistema compara 3 opções de trajeto conforme seu perfil (cadeirante, deficiência visual ou idoso), priorizando calçadas com rampas e piso tátil.'
      },
      {
        chaves: ['alerta', 'alertas', 'gps', 'vibracao', 'bipe', 'som', 'simular', 'distancia'],
        resposta: 'Na <strong>Página 6 (Alertas GPS)</strong> você escolhe a distância de aviso (15m, 30m ou 50m) e ativa alertas em 4 canais simultâneos: bipe sonoro, narração por voz, vibração no celular e alerta visual.'
      },
      {
        chaves: ['prefeitura', 'prefeituras', 'grafico', 'dados', 'estatistica', 'gestao'],
        resposta: 'Na <strong>Página 8 (Prefeituras)</strong> há gráficos com o percentual de ocorrências por infraestrutura (buracos 38%, rampas 26%, piso tátil 19%, semáforos 11% e obras 6%) para apoiar políticas públicas.'
      },
      {
        chaves: ['video', 'audio', 'mudo', 'legenda', 'audiodescricao', 'faq', 'ajuda'],
        resposta: 'Na <strong>Página 9 (Ajuda & Vídeo)</strong> você encontra o FAQ completo e o vídeo demonstrativo interativo com narração em áudio, legendas sincronizadas e botões de iniciar, pausar e reiniciar.'
      },
      {
        chaves: ['equipe', 'autor', 'autores', 'criador', 'quem fez', 'unicid', 'lucas', 'pedro', 'marcos', 'nathan'],
        resposta: 'O HyperAcess foi desenvolvido na <strong>UNICID (2026)</strong> pelos estudantes: <strong>Lucas de Moraes Covelo</strong> (Coordenação e Arquitetura), <strong>Pedro Henrique de Oliveira</strong> (Acessibilidade WCAG, JS e Assistente IA), <strong>Marcos Vinicius Calixto Emerenciano</strong> (Layout, CSS e Mapa Satélite) e <strong>Nathan Caue Sanchez Martins</strong> (Front-End e Módulos JavaScript: armazenamento no localStorage).'
      },
      {
        chaves: ['contato', 'email', 'falar', 'suporte', 'ong', 'voluntario', 'parceria'],
        resposta: 'Para enviar dúvidas, sugestões ou propor parcerias com ONGs e prefeituras, acesse a <strong>Página 10 (Fale Conosco)</strong> pelo menu principal ou rodapé.'
      },
      {
        chaves: ['gratis', 'gratuito', 'preco', 'custo', 'pagar', 'offline', 'internet'],
        resposta: 'O HyperAcess é <strong>100% gratuito</strong> para todos os cidadãos e armazena preferências e rascunhos localmente no navegador.'
      }
    ];

    function gerarRespostaIA(pergunta) {
      const limpa = pergunta
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '');

      let melhor = null;
      let maxPontos = 0;

      for (const item of conhecimentoSite) {
        let pts = 0;
        for (const chave of item.chaves) {
          if (limpa.includes(chave)) pts++;
        }
        if (pts > maxPontos) {
          maxPontos = pts;
          melhor = item.resposta;
        }
      }

      if (melhor) return melhor;

      return 'Entendi sua pergunta! No <strong>HyperAcess</strong> você pode explorar o <strong>Mapa Satélite (Pág. 3)</strong>, <strong>Abrir Chamados (Pág. 4)</strong>, <strong>Comparar Rotas Acessíveis (Pág. 5)</strong>, testar <strong>Alertas GPS (Pág. 6)</strong>, ajustar a <strong>Acessibilidade WCAG</strong> no topo ou assistir ao <strong>Vídeo Demonstrativo (Pág. 9)</strong>. Sobre qual dessas funções você quer saber mais detalhes?';
    }

    function adicionarMensagemChat(texto, tipo) {
      const div = document.createElement('div');
      div.className = tipo === 'user' ? 'msg-user' : 'msg-bot';
      if (tipo === 'user') {
        div.textContent = texto;
      } else {
        div.innerHTML = texto;
        ultimaRespostaTextoLimpo = div.textContent;
        if (iaVozAtiva) {
          falarRespostaIA(ultimaRespostaTextoLimpo);
        }
      }
      chatMensagens.appendChild(div);
      chatMensagens.scrollTop = chatMensagens.scrollHeight;
    }

    function processarPerguntaChat(texto) {
      if (!texto.trim()) return;
      adicionarMensagemChat(texto, 'user');
      setTimeout(() => {
        const resposta = gerarRespostaIA(texto);
        adicionarMensagemChat(resposta, 'bot');
      }, 220);
    }

    formChat.addEventListener('submit', (e) => {
      e.preventDefault();
      const texto = inputChat.value;
      inputChat.value = '';
      processarPerguntaChat(texto);
    });

    if (new URLSearchParams(location.search).get('enviado') === '1') {
      navegarPara('pag-10');
      document.getElementById('retorno-contato').textContent = '✅ Mensagem enviada! A equipe recebeu seu feedback e uma cópia foi enviada para o seu e-mail.';
      history.replaceState(null, '', location.pathname);
    }

    document.querySelectorAll('.chip-sugestao').forEach(chip => {
      chip.addEventListener('click', () => {
        processarPerguntaChat(chip.getAttribute('data-pergunta'));
      });
    });
  </script>
