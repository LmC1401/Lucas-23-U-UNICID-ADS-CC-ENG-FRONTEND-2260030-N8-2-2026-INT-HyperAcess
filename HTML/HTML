    <!-- ==================== PÁGINA 4: CHAMADOS ==================== -->
    <section id="pag-4" class="spa-page" aria-labelledby="titulo-pag-4">
      <div class="page-header">
        <span class="badge-tag">Colaboração Cidadã</span>
        <h1 id="titulo-pag-4">Registrar Chamado de Barreira Urbana</h1>
        <p>Reporte um problema em menos de 1 minuto. Seu rascunho é salvo automaticamente no navegador e adicionado ao mapa satélite.</p>
      </div>

      <div class="card" style="margin-bottom:24px;">
        <form id="form-chamado" novalidate>
          <div class="form-grid">
            <div class="form-group">
              <label for="chamado-nome">Seu Nome (ou Apelido) *</label>
              <input type="text" id="chamado-nome" name="nome" placeholder="Ex.: Pedro Henrique" required>
              <span class="erro-campo" id="erro-nome" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="chamado-categoria">Tipo de Barreira *</label>
              <select id="chamado-categoria" name="categoria" required>
                <option value="">Selecione...</option>
                <option value="buraco">Buraco ou Calçada Quebrada</option>
                <option value="rampa">Ausência de Rampa de Acessibilidade</option>
                <option value="piso">Piso Tátil Danificado / Obstruído</option>
                <option value="semaforo">Semáforo Sem Alerta Sonoro</option>
                <option value="obra">Obra sem Passagem Segura</option>
              </select>
              <span class="erro-campo" id="erro-categoria" aria-live="polite"></span>
            </div>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label for="chamado-regiao">Região / Município *</label>
              <select id="chamado-regiao" name="regiao" required>
                <option value="">Selecione a região...</option>
                <option value="Centro SP">Centro SP</option>
                <option value="Zona Leste">Zona Leste</option>
                <option value="Zona Sul">Zona Sul</option>
                <option value="Zona Oeste">Zona Oeste</option>
                <option value="Zona Norte">Zona Norte</option>
                <option value="Santo André">Santo André</option>
                <option value="São Bernardo">São Bernardo do Campo</option>
                <option value="São Caetano">São Caetano do Sul</option>
              </select>
              <span class="erro-campo" id="erro-regiao" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="chamado-endereco">Endereço ou Ponto de Referência *</label>
              <input type="text" id="chamado-endereco" name="endereco" placeholder="Ex.: Av. Paulista, 1578 - próximo ao metrô" required>
              <span class="erro-campo" id="erro-endereco" aria-live="polite"></span>
            </div>
          </div>

          <div class="form-group">
            <label for="chamado-descricao">Descrição Detalhada *</label>
            <textarea id="chamado-descricao" name="descricao" rows="3" placeholder="Descreva o tamanho do obstáculo e como ele afeta cadeirantes ou deficientes visuais..." required></textarea>
            <span class="erro-campo" id="erro-descricao" aria-live="polite"></span>
          </div>

          <div style="display:flex; flex-wrap:wrap; gap:12px;">
            <button type="submit" class="btn-primary">📨 Enviar Chamado e Gerar Protocolo</button>
            <button type="button" class="btn-secondary" id="btn-limpar-rascunho">🗑️ Limpar Rascunho</button>
          </div>
        </form>

        <div id="retorno-chamado" role="status" aria-live="polite" style="margin-top:16px; font-weight:700;"></div>
      </div>

      <div class="card">
        <h2>Últimos Chamados Registrados</h2>
        <div class="tabela-resp" style="margin-top:12px;">
