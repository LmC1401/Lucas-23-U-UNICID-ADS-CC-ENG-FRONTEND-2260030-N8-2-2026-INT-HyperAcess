          <button type="button" class="btn-sinalizador" data-tipo="semaforo" aria-pressed="false"><span class="pino-badge" style="background:var(--cor-semaforo);">S</span> Semáforo Sonoro</button>
          <button type="button" class="btn-sinalizador" data-tipo="obra" aria-pressed="false"><span class="pino-badge" style="background:var(--cor-obra);">O</span> Obra / Obstrução</button>
